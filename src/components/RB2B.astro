<!-- RB2B Tracking - starts as soon as analytics consent is granted -->
<script is:inline>
	(() => {
		const CONSENT_KEY = "cookie-consent";

		function loadRB2B() {
			// Keep this loader identical to the RB2B dashboard snippet.
			// eslint-disable-next-line @typescript-eslint/no-unused-expressions
			!function(key) {
				if (window.reb2b) return;
				window.reb2b = { loaded: true };
				var s = document.createElement("script");
				s.async = true;
				s.src =
					"https://b2bjsstore.s3.us-west-2.amazonaws.com/b/" +
					key +
					"/" +
					key +
					".js.gz";
				document
					.getElementsByTagName("script")[0]
					.parentNode.insertBefore(s, document.getElementsByTagName("script")[0]);
			}("W6Z57HZZ9P0X");
		}

		if (localStorage.getItem(CONSENT_KEY) === "accepted") {
			loadRB2B();
		}

		window.addEventListener("cookie-consent-updated", (event) => {
			if (event && event.detail === "accepted") {
				// RB2B's validator needs the loader to run promptly after acceptance.
				loadRB2B();
			}
		});
	})();
</script>
