---
/**
 * The Many Hats hero: a statement on the left whose role word, underline
 * and color switch with the hat (at the moment it lands; nothing in the
 * statement animates), and Anthony at his desk on the right.
 * A floating glass dock cycles the hats (autoplay, with the timer drawn as a
 * ring around the active dot, which is also the pause button).
 *
 * The swap itself (flight, settle, brim shadow, hair) is `createHatStage`;
 * this component adds the words, colors and controls through its hooks.
 */
import { ArrowDown } from "lucide-react";
import HatStage from "./many-hats/HatStage.astro";
import { hatRoles, serializeHatRoles } from "../data/many-hats-roles";

interface Props {
	/** the page's first section: load the portrait at high priority */
	priority?: boolean;
}

const { priority = false } = Astro.props;
const first = hatRoles[0];
// keep in step with --sw below
// phones and portrait tablets stack; landscape-ish windows from 640px wide
// (and any clearly landscape window, like a phone held sideways) sit side
// by side like desktop (keep in step with the media queries below)
const stageSizes = "(max-width: 639px) and (max-aspect-ratio: 6/5) 135vw, (max-width: 899px) and (max-aspect-ratio: 5/6) 135vw, min(78vw, 100vh)";
---

{
	/* the headline is the first thing on screen: fetch its font right away
	   (without it the late swap shifts the layout slightly) */
	priority && (
		<link
			rel="preload"
			href="/fonts/newsreader/Newsreader-SemiBold-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
	)
}
<section
	class="mhd"
	data-mhd
	aria-labelledby="mhd-title"
	style={`--ink: ${first.color.ink}; --cap: ${first.color.cap}; --paper: ${first.color.paper};`}
>
	<div class="mhd-inner">
		<!-- The statement. Each block stacks invisible copies of every role
		     beneath the live one, so it is always as tall as its longest
		     role: nothing below it moves when the hat changes. -->
		<!-- Headline, subhead and buttons at fixed gaps on desktop (the copy
		     is written to a steady 3 + ~2 lines, so they do not jump). On
		     phones the buttons follow the subhead too (fit script), and the
		     photo and its hat dock fill the rest of the first screen;
		     without JS the buttons follow the photo. Invisible
		     copies of every headline + subhead reserve the tallest, so the
		     photo never moves. -->
		<div class="mhd-statement">
			<div class="mhd-slot">
				{
					hatRoles.map((role) => (
						<div class="mhd-sizer" aria-hidden="true">
							<p class="mhd-title">
								<span class="mhd-word-wrap">{role.hero.word}</span>{" "}
								<span class="mhd-rest">{role.hero.rest}</span>
							</p>
							<p class="mhd-sub">{role.hero.sub}</p>
						</div>
					))
				}
				<div class="mhd-live">
					<h1 class="mhd-title" id="mhd-title">
						<span class="mhd-word-wrap">
							<span class="mhd-word" data-mhd-word>{first.hero.word}</span>
							<span class="mhd-brush" aria-hidden="true"></span>
						</span>{" "}
						<span class="mhd-rest" data-mhd-rest>{first.hero.rest}</span>
					</h1>
					<p class="mhd-sub" data-mhd-sub>{first.hero.sub}</p>
				</div>
			</div>
		</div>

		<div class="mhd-support">
			<div class="mhd-actions">
				<button type="button" class="mhd-cta" data-contact-dialog-open>Let’s talk</button>
				<a class="mhd-overview" href="#work-overview">
					<span>Work overview</span>
					<ArrowDown size={18} strokeWidth={1.8} aria-hidden="true" />
				</a>
			</div>
		</div>

		<div class="mhd-figure" data-mhd-figure>
			<HatStage class="mhd-stage" framing="desk" sizes={stageSizes} priority={priority} />

			<nav class="mhd-dock" aria-label="Choose a hat">
				<p class="mhd-dock-label" aria-hidden="true">
					Change hats
				</p>
				<div class="mhd-dock-row">
					<button type="button" class="mhd-arrow" data-mhd-prev aria-label="Previous hat">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" /></svg>
					</button>
					<div class="mhd-dots">
						{
							hatRoles.map((role, index) => (
								<button
									type="button"
									class="mhd-dot"
									data-mhd-dot={index}
									aria-label={role.label}
									aria-current={index === 0 ? "true" : undefined}
								>
									<span class="mhd-dot-core">
										<svg class="mhd-ring" viewBox="0 0 32 32" aria-hidden="true">
											<circle class="mhd-ring-track" cx="16" cy="16" r="14.6" />
											<circle class="mhd-ring-fill" cx="16" cy="16" r="14.6" pathLength="1" />
										</svg>
										<svg class="mhd-icon mhd-icon-pause" viewBox="0 0 24 24" aria-hidden="true">
											<path d="M9 6.5v11M15 6.5v11" />
										</svg>
										<svg class="mhd-icon mhd-icon-play" viewBox="0 0 24 24" aria-hidden="true">
											<path d="M9 6.8v10.4l8.2-5.2z" />
										</svg>
									</span>
								</button>
							))
						}
					</div>
					<button type="button" class="mhd-arrow" data-mhd-next aria-label="Next hat">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
					</button>
				</div>
			</nav>
		</div>
	</div>

	<p class="mhd-sr" aria-live="polite" data-mhd-status></p>
	<script is:inline type="application/json" data-hat-roles set:html={serializeHatRoles("desk")} />
</section>
<script is:inline>
	// Stacked layout (phones, portrait tablets): the buttons sit right under
	// the subhead and the photo takes the rest of the first screen (rising
	// beside the buttons when they clear its shoulders, then drawn a little
	// smaller, then cut shorter), so the buttons and hat dock stay in view.
	// Side by side: CSS does it all. Runs before first paint (so nothing
	// jumps), then on resize/rotation and as the text settles.
	(() => {
		const root = document.currentScript.previousElementSibling;
		const fig = root.querySelector(".mhd-figure");
		const actions = root.querySelector(".mhd-actions");
		const mobile = window.matchMedia("(max-width: 639px) and (max-aspect-ratio: 6/5), (max-width: 899px) and (max-aspect-ratio: 5/6)");
		const probe = document.createElement("div");
		probe.style.cssText = "position:absolute;visibility:hidden;height:100svh;width:0";
		const fit = () => {
			root.appendChild(probe);
			const screen = probe.offsetHeight;
			probe.remove();
			if (!mobile.matches) {
				root.classList.remove("mhd-acts-up");
				root.style.removeProperty("--fig-sw");
				root.style.removeProperty("--fig-rise");
				root.style.removeProperty("--fig-h");
				// keep the photo near the text: his shoulder (canvas x ~330)
				// a fixed-ish gap past the text, never further right than the
				// column would put it
				root.style.removeProperty("--stage-x");
				root.classList.remove("mhd-pulled");
				const stage = fig.querySelector(".mhd-stage");
				const k = stage.offsetWidth / 1254;
				const text = Math.max(
					root.querySelector(".mhd-live .mhd-title").getBoundingClientRect().right,
					root.querySelector(".mhd-live .mhd-sub").getBoundingClientRect().right
				);
				const gap = Math.min(144, Math.max(56, innerWidth * 0.08));
				const box = fig.getBoundingClientRect();
				const current = stage.getBoundingClientRect().left - box.left;
				const near = text + gap - 330 * k - box.left;
				const pulled = near < current;
				root.classList.toggle("mhd-pulled", pulled);
				if (pulled) root.style.setProperty("--stage-x", Math.round(near) + "px");
				return;
			}
			root.style.removeProperty("--fig-sw");
			root.style.removeProperty("--fig-rise");
			root.style.removeProperty("--stage-x");
			root.classList.remove("mhd-pulled");
			root.classList.add("mhd-acts-up");
			const sw0 = fig.clientWidth * 1.35; // the stage, as in the CSS
			const top0 = fig.getBoundingClientRect().top; // before any rise
			const acts = actions.getBoundingClientRect().bottom;
			const lift = parseFloat(getComputedStyle(actions).marginTop) + actions.offsetHeight;
			const dock = root.querySelector(".mhd-dock").offsetHeight + 16; // + its 1rem inset
			// Canvas rows: crown 116, chin ~560, the jacket reaches the
			// buttons' column at ~580; the photo is cut at mid-torso (1050).
			const layout = (sw) => {
				const k = sw / 1254;
				// rise beside the buttons, but keep them clear of the shoulders
				const rise = Math.max(0, Math.min(lift, top0 + 20 + (580 - 116) * k - acts - 8));
				const top = top0 - rise;
				const room = screen - (top + window.scrollY);
				// the dock must sit below the chin, never over the face
				const faceClear = room - dock >= 20 + (560 - 116) * k + 12;
				return { rise, room, faceClear, tall: 20 + (1050 - 116) * k };
			};
			// the largest photo (down to 70%) that keeps the face clear
			let sw = sw0;
			let l = layout(sw);
			while (!l.faceClear && sw > sw0 * 0.7) {
				sw = Math.max(sw0 * 0.7, sw - sw0 * 0.02);
				l = layout(sw);
			}
			if (sw < sw0) root.style.setProperty("--fig-sw", Math.floor(sw) + "px");
			if (l.rise) root.style.setProperty("--fig-rise", Math.round(l.rise) + "px");
			root.style.setProperty("--fig-h", Math.round(Math.min(l.tall, l.room)) + "px");
		};
		fit();
		let frame = 0;
		const refit = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(fit);
		};
		addEventListener("resize", refit);
		// the text block's size settles as styles and the display font load
		if ("ResizeObserver" in window) {
			new ResizeObserver(refit).observe(root.querySelector(".mhd-statement"));
		}
		document.fonts?.ready.then(refit);
	})();
</script>

<script>
	import { mount, readRoles, reducedMotion, type ClientHatRole } from "../scripts/many-hats/shared";
	import { createHatStage, type FlightTiming } from "../scripts/many-hats/hat-stage";

	type HeroRole = ClientHatRole & {
		hero: { word: string; rest: string; sub: string };
	};

	/** ms each hat is worn before the next one (the ring around the dot) */
	const DWELL = 6200;
	/** ms for the text block to disappear when a hat is chosen */
	const HIDE_MS = 90;

	mount("[data-mhd]", (root) => {
		const roles = readRoles(root) as HeroRole[];
		const hat = createHatStage(root);
		const $ = <T extends Element>(selector: string) => root.querySelector<T>(selector) as T;

		const word = $<HTMLElement>("[data-mhd-word]");
		const blocks = [$<HTMLElement>(".mhd-statement"), $<HTMLElement>(".mhd-support")];
		const rest = $<HTMLElement>("[data-mhd-rest]");
		const sub = $<HTMLElement>("[data-mhd-sub]");
		const status = $<HTMLElement>("[data-mhd-status]");
		const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-mhd-dot]"));
		const cores = dots.map((dot) => dot.querySelector<HTMLElement>(".mhd-dot-core") as HTMLElement);
		const rings = dots.map((dot) => dot.querySelector<SVGCircleElement>(".mhd-ring-fill") as SVGCircleElement);

		let active = 0;
		let busy = false;
		let queued: number | null = null;
		let autoplay = !reducedMotion();
		let paused = false;
		let inView = false;
		let holding = false; // keyboard focus inside the section
		let timer: Animation | null = null;

		// --- words and color ------------------------------------------------
		const setCopy = (role: HeroRole) => {
			// the word, line and button switch color; the paper eases (CSS)
			root.style.setProperty("--ink", role.color.ink);
			root.style.setProperty("--cap", role.color.cap);
			root.style.setProperty("--paper", role.color.paper);
			word.textContent = role.hero.word;
			rest.textContent = role.hero.rest;
			sub.textContent = role.hero.sub;
		};

		/** The text block (statement, subhead, buttons) disappears the moment a
		 * hat is chosen, switches words and colors while hidden, and fades
		 * back in at the pace of the incoming hat, arriving with it. Nothing
		 * inside the block moves on its own. */
		const hideBlock = (to: HeroRole) => {
			const out = blocks.map((block) =>
				block.animate([{ opacity: 1 }, { opacity: 0 }], {
					duration: HIDE_MS,
					easing: "ease-out",
					fill: "forwards",
				})
			);
			void Promise.all(out.map((animation) => animation.finished))
				.then(() => setCopy(to))
				.catch(() => undefined);
		};

		const showBlock = ({ entryDuration }: FlightTiming) =>
			blocks.map((block) =>
				block.animate([{ opacity: 0 }, { opacity: 1 }], {
					duration: entryDuration,
					easing: "cubic-bezier(.4,0,.6,1)",
					fill: "both",
				})
			);

		// --- the dock -------------------------------------------------------
		const stopped = () => !autoplay || paused;

		const setDots = (index: number) => {
			dots.forEach((dot, i) => {
				if (i === index) dot.setAttribute("aria-current", "true");
				else dot.removeAttribute("aria-current");
				dot.setAttribute(
					"aria-label",
					i === index
						? `${roles[i].label}: ${stopped() ? "play" : "pause"} hat rotation`
						: roles[i].label
				);
			});
			root.classList.toggle("is-paused", stopped());
		};

		/** Only the two dots involved move: the newly active one springs up
		 * past its size and settles, the old one tucks down. */
		const bounceDots = (from: number, to: number) => {
			if (reducedMotion()) return;
			cores[to].animate(
				[
					{ transform: "scale(0.3)" },
					{ transform: "scale(1.16)", offset: 0.5 },
					{ transform: "scale(0.94)", offset: 0.78 },
					{ transform: "scale(1)" },
				],
				{ duration: 620, easing: "cubic-bezier(.3,.7,.4,1)" }
			);
			cores[from].animate(
				[
					{ transform: "scale(1)" },
					{ transform: "scale(0.16)", offset: 0.6 },
					{ transform: "scale(0.3)" },
				],
				{ duration: 460, easing: "cubic-bezier(.4,0,.2,1)" }
			);
		};

		// --- autoplay: the ring's own animation is the timer -----------------
		const canRun = () =>
			!stopped() && inView && !holding && document.visibilityState === "visible";

		const syncTimer = () => {
			if (!timer) return;
			if (canRun() && !busy) timer.play();
			else timer.pause();
		};

		const startTimer = () => {
			timer?.cancel();
			timer = null;
			if (stopped()) return;
			const run = rings[active].animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], {
				duration: DWELL,
				easing: "linear",
				fill: "forwards",
			});
			timer = run;
			run.finished
				.then(() => {
					if (timer === run && canRun()) void show((active + 1) % roles.length);
				})
				.catch(() => undefined);
			syncTimer();
		};

		// --- the swap -------------------------------------------------------
		const show = async (index: number) => {
			if (index === active && !busy) return;
			if (busy) {
				queued = index;
				return;
			}
			busy = true;
			timer?.cancel();
			timer = null;
			const from = roles[active];
			const to = roles[index];
			bounceDots(active, index);
			setDots(index);
			if (!reducedMotion()) hideBlock(to);
			status.textContent = `${to.hero.word} ${to.hero.rest}`;

			try {
				if (reducedMotion()) {
					setCopy(to);
					await hat.showInstantly(to);
				} else {
					await hat.toss(from, to, {
						onLaunch: (timing) => showBlock(timing),
					});
				}
			} catch {
				// never leave the controls dead: settle on the new hat
				setCopy(to);
				await hat.showInstantly(to).catch(() => undefined);
			}
			setCopy(to);
			blocks.forEach((block) => block.getAnimations().forEach((animation) => animation.cancel()));

			active = index;
			busy = false;
			if (queued !== null && queued !== active) {
				const next = queued;
				queued = null;
				void show(next);
				return;
			}
			queued = null;
			startTimer();
		};

		const togglePause = () => {
			if (stopped()) {
				autoplay = true;
				paused = false;
			} else {
				paused = true;
			}
			setDots(active);
			if (stopped()) {
				timer?.pause();
			} else if (timer) {
				syncTimer();
			} else {
				startTimer();
			}
		};

		// --- input ----------------------------------------------------------
		// Picking a hat never stops the rotation; only the pause button does.
		dots.forEach((dot, index) => {
			dot.addEventListener("click", () => {
				if (index === active && !busy) togglePause();
				else void show(index);
			});
			dot.addEventListener("pointerenter", () => void hat.warmRole(roles[index]));
		});
		const step = (by: number) => void show((active + by + roles.length) % roles.length);
		$<HTMLButtonElement>("[data-mhd-prev]").addEventListener("click", () => step(-1));
		$<HTMLButtonElement>("[data-mhd-next]").addEventListener("click", () => step(1));

		// keyboard users get a hold while focus is inside the section
		root.addEventListener("focusin", (event) => {
			holding = (event.target as Element).matches(":focus-visible");
			syncTimer();
		});
		root.addEventListener("focusout", (event) => {
			if (root.contains(event.relatedTarget as Node)) return;
			holding = false;
			syncTimer();
		});
		document.addEventListener("visibilitychange", syncTimer);

		// Prepare the swaps only once on screen and after the page has loaded
		// and gone idle, so nothing competes with the portrait itself.
		const pageSettled = new Promise<void>((resolve) => {
			const idle = () =>
				"requestIdleCallback" in window
					? window.requestIdleCallback(() => resolve(), { timeout: 2000 })
					: window.setTimeout(resolve, 300);
			if (document.readyState === "complete") idle();
			else window.addEventListener("load", idle, { once: true });
		});
		let prefetched = false;
		const prefetch = () => {
			if (prefetched) return;
			prefetched = true;
			void pageSettled.then(async () => {
				await hat.loadBare();
				for (let i = 1; i <= roles.length; i += 1) {
					await hat.warmRole(roles[(active + i) % roles.length]);
				}
			});
		};
		if ("IntersectionObserver" in window) {
			new IntersectionObserver(
				([entry]) => {
					inView = entry.isIntersecting;
					if (inView) prefetch();
					syncTimer();
				},
				{ threshold: 0.45 }
			).observe(root);
		} else {
			inView = true;
			prefetch();
		}

		setDots(active);
		startTimer();
	});
</script>

<style>
	.mhd {
		--text: #161a26;
		--muted: #555a64;
		--nav-clear: 4.0625rem;
		--gutter: clamp(1.25rem, 5vw, 4.5rem);
		--spring: cubic-bezier(0.34, 1.56, 0.64, 1);
		position: relative;
		overflow: clip;
		background-color: var(--paper);
		color: var(--text);
		font-family: "Inter", system-ui, sans-serif;
		transition: background-color 900ms ease;
	}

	.mhd-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ---- layout ----------------------------------------------------------
	   Desktop: statement and support stack on the left; the photograph
	   fills the right column and bleeds off the right and bottom edges.
	   Phones: statement, then the photograph (with the dock), then support. */
	.mhd-inner {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
		grid-template-areas:
			"statement figure"
			"support figure"
			". figure";
		grid-template-rows: auto auto 1fr;
		column-gap: clamp(1rem, 3vw, 3rem);
		min-height: min(100svh, 60rem);
		/* past the nav's 85rem container, the text lines up with its logo
		   (and the photo follows the text, see --stage-x) */
		padding: calc(var(--nav-clear) + clamp(1rem, 6vh, 4.5rem)) 0 0
			max(var(--gutter), (100% - 85rem) / 2 + 2rem);
	}

	.mhd-statement {
		grid-area: statement;
		position: relative;
		z-index: 1;
		align-self: end;
	}

	.mhd-support {
		grid-area: support;
		position: relative;
		z-index: 1;
		padding-bottom: clamp(1.5rem, 8vh, 5rem);
	}

	/* stacked copies: the live text over invisible copies of every role;
	   the live unit hugs the top, so spare room falls below the subhead */
	.mhd-slot {
		display: grid;
	}
	.mhd-slot > :global(*) {
		grid-area: 1 / 1;
	}
	.mhd-sizer {
		visibility: hidden;
	}
	/* headlines break at a width tied to their own size, so they wrap the
	   same way (3 lines) at every screen size */
	.mhd-statement .mhd-title {
		max-width: 6.5em;
	}
	/* desktop: no reserved height, the buttons follow the subhead directly.
	   Line breaks are tied to the type size (em widths), so every desktop
	   size breaks the same way: headlines 3 lines, subheads ~2. */
	@media (min-width: 900px), (min-width: 640px) and (min-aspect-ratio: 501/600), (min-aspect-ratio: 601/500) {
		.mhd-sizer {
			display: none;
		}
		.mhd-statement .mhd-sub {
			max-width: 26em;
		}
	}
	.mhd-live {
		align-self: start;
	}

	/* ---- the statement --------------------------------------------------- */
	.mhd-title {
		margin: 0;
		/* the design system's display face (src/styles/global.css) */
		font-family: var(--font-display);
		/* scales with the window's height too, so short desktop windows keep
		   the headline, subhead and buttons on the first screen */
		/* the floor gives way on very short windows, so the buttons fit */
		font-size: clamp(min(2.9rem, 9svh), min(6.6vw, 12.5svh), 6.75rem);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.035em;
		color: var(--ink);
		text-wrap: balance;
		/* The underline sits behind every letter of the headline (z-index -1
		   inside this isolated stacking context). Each letter carries an
		   outline in the page color, painted under its fill, so where a
		   letter crosses the line the line breaks cleanly around it; on the
		   bare page the outline is invisible. */
		isolation: isolate;
		-webkit-text-stroke: 0.045em var(--paper);
		paint-order: stroke fill;
		/* the outline follows the paper's ease so it stays invisible */
		transition: -webkit-text-stroke-color 900ms ease;
	}

	.mhd-word-wrap {
		position: relative;
		display: inline-block;
	}

	.mhd-word {
		display: inline-block;
	}

