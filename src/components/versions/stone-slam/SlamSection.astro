---

---

<div
	id="hire-section"
	class="relative z-10 flex h-screen flex-col items-center justify-center overflow-hidden bg-blue-600 px-6 py-20 text-white"
>
	<div
		class="mx-auto flex w-full max-w-7xl flex-col items-center justify-center gap-8 md:gap-12"
	>
		<h2
			id="slam-target"
			class="slam-text text-center text-[min(15vw,20vh)] leading-[0.85] font-black tracking-tighter uppercase drop-shadow-2xl select-none"
			style="opacity: 0; transform: scale(8);"
		>
			Hire<br />Tony.
		</h2>
		<p
			class="max-w-2xl text-center text-lg font-medium sm:text-xl md:text-2xl lg:text-3xl"
			id="subtitle"
			style="opacity: 0;"
		>
			I hit deadlines, protect your budget, and cut the fluff without cutting
			corners.
		</p>
	</div>
</div>

<script>
	// anime.js is bundled (it used to load from a CDN at runtime, which delayed
	// or, if the CDN was unreachable, disabled the slam entirely).
	// @ts-expect-error animejs v3 ships no type declarations
	import anime from "animejs";

	const container = document.getElementById("hire-section");
	const title = document.getElementById("slam-target");
	const subtitle = document.getElementById("subtitle");
	const heroContent = document.getElementById("hero-content");

	if (container && title && subtitle && heroContent) {
		let hasSlammed = false;
		let isAnimating = false;
		let isSnapping = false;
		let lastScrollY = window.scrollY;

		const unlockScroll = () => {
			isAnimating = false;
			window.lenis?.start();
		};

		const slam = () => {
			hasSlammed = true;
			isAnimating = true;
			isSnapping = false;

			// Lock scrolling and square the section to the viewport so the slam
			// always lands on a full blue screen, however the visitor got here.
			const lenis = window.lenis;
			if (lenis) {
				lenis.stop();
				const top = container.getBoundingClientRect().top;
				if (top > -window.innerHeight) {
					lenis.scrollTo(container, { immediate: true, force: true });
				}
			}

			// Hide the hero content and the cotton ball right away, independent
			// of the animation timeline.
			window.dispatchEvent(new CustomEvent("slam-impact"));

			try {
				anime
					.timeline({
						easing: "easeOutExpo",
						duration: 600,
						complete: unlockScroll,
					})
					// 1. Hide hero content
					.add({
						targets: [heroContent],
						opacity: 0,
						duration: 100,
						easing: "linear",
					})
					// 2. Slam text in
					.add(
						{
							targets: title,
							scale: [8, 1],
							opacity: [0, 1],
							duration: 600,
						},
						"-=50"
					)
					// 3. Shake background
					.add(
						{
							targets: container,
							translateX: [
								{ value: -10, duration: 50 },
								{ value: 10, duration: 50 },
								{ value: -10, duration: 50 },
								{ value: 10, duration: 50 },
								{ value: -5, duration: 50 },
								{ value: 5, duration: 50 },
								{ value: 0, duration: 50 },
							],
							translateY: [
								{ value: -10, duration: 50 },
								{ value: 10, duration: 50 },
								{ value: -10, duration: 50 },
								{ value: 10, duration: 50 },
								{ value: -5, duration: 50 },
								{ value: 5, duration: 50 },
								{ value: 0, duration: 50 },
							],
							duration: 400,
							easing: "linear",
						},
						"-=400"
					)
					// 4. Show subtitle
					.add(
						{
							targets: subtitle,
							opacity: [0, 1],
							translateY: [20, 0],
							duration: 600,
						},
						"-=200"
					);
			} catch (e) {
				console.error("Slam animation error", e);
				unlockScroll();
			}
		};

		const reset = () => {
			hasSlammed = false;

			// Tell ThreeScene and the hero to come back
			window.dispatchEvent(new CustomEvent("slam-reset"));

			// Batch all resets in a single frame to prevent layout thrashing
			requestAnimationFrame(() => {
				anime.set([heroContent], { opacity: 1 });
				anime.set(title, { scale: 8, opacity: 0 });
				anime.set(container, { translateX: 0, translateY: 0 });
				anime.set(subtitle, { opacity: 0, translateY: 20 });
			});
		};

		const checkScroll = () => {
			const scrollY = window.scrollY;
			const scrollingDown = scrollY > lastScrollY;
			lastScrollY = scrollY;

			if (isAnimating) return;

			const windowHeight = window.innerHeight;
			const top = container.getBoundingClientRect().top;

			if (!hasSlammed && top <= 10) {
				// The section has reached the top of the viewport
				slam();
			} else if (
				!hasSlammed &&
				!isSnapping &&
				scrollingDown &&
				top < windowHeight * 0.5 &&
				window.lenis
			) {
				// Slow scrolls used to leave the cotton ball floating over a
				// half-revealed blue section. Once the section covers half the
				// screen, finish the scroll so the slam always fires.
				isSnapping = true;
				window.lenis.scrollTo(container, {
					duration: 0.45,
					lock: true,
					onComplete: () => {
						isSnapping = false;
					},
				});
			} else if (hasSlammed && top > windowHeight * 0.9) {
				// Scrolled most of the way back up: rearm
				reset();
			}
		};

		window.addEventListener("scroll", checkScroll, { passive: true });
		// Check once on load (e.g. restored scroll position)
		setTimeout(checkScroll, 100);
	}
</script>
