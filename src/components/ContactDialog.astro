---
import { Check, Copy, Linkedin, Mail, Phone, Send, X } from "lucide-react";

const email = "anthonyrosen@gmail.com";
const phoneDisplay = "612-281-2280";
const phoneHref = "+16122812280";
const contactEndpoint = "/api/contact";
---

<dialog
	id="contact-dialog"
	class="contact-dialog"
	aria-labelledby="contact-dialog-title"
	aria-describedby="contact-dialog-description"
>
	<div class="contact-dialog-shell">
		<button
			type="button"
			class="contact-dialog-close"
			aria-label="Close contact dialog"
			data-contact-dialog-close
			autofocus
		>
			<X size={20} strokeWidth={1.8} aria-hidden="true" />
		</button>

		<section class="contact-dialog-details">
			<p class="contact-dialog-eyebrow">Let’s make something useful</p>
			<h2 id="contact-dialog-title">Ready to get to work?</h2>
			<p id="contact-dialog-description" class="contact-dialog-intro">
				Choose the way that works for you. A short note is plenty—I’ll take it
				from there.
			</p>

			<div class="contact-dialog-direct" data-copy-area>
				<div class="contact-dialog-copy-group" data-copy-group>
					<div class="contact-dialog-copy-row">
						<button
							type="button"
							class="contact-dialog-copy"
							data-copy-value={email}
							data-copy-kind="email"
							data-copy-location="contact_dialog"
							aria-describedby="contact-copy-status"
						>
							<span>{email}</span>
							<span class="contact-dialog-icon" aria-hidden="true">
								<Copy size={18} strokeWidth={1.8} data-copy-icon />
								<Check size={18} strokeWidth={2} data-check-icon hidden />
							</span>
							<span class="sr-only">Copy email address</span>
						</button>
						<a
							class="contact-dialog-action"
							href={`mailto:${email}`}
							aria-label={`Open a new email to ${email}`}
						>
							<Mail size={19} strokeWidth={1.8} aria-hidden="true" />
						</a>
					</div>
				</div>

				<div class="contact-dialog-copy-group" data-copy-group>
					<div class="contact-dialog-copy-row">
						<button
							type="button"
							class="contact-dialog-copy"
							data-copy-value={phoneDisplay}
							data-copy-kind="phone"
							data-copy-location="contact_dialog"
							aria-describedby="contact-copy-status"
						>
							<span>{phoneDisplay}</span>
							<span class="contact-dialog-icon" aria-hidden="true">
								<Copy size={18} strokeWidth={1.8} data-copy-icon />
								<Check size={18} strokeWidth={2} data-check-icon hidden />
							</span>
							<span class="sr-only">Copy phone number</span>
						</button>
						<a
							class="contact-dialog-action"
							href={`tel:${phoneHref}`}
							aria-label={`Call ${phoneDisplay}`}
						>
							<Phone size={19} strokeWidth={1.8} aria-hidden="true" />
						</a>
					</div>
					<p
						id="contact-copy-status"
						class="contact-dialog-status"
						data-copy-status
						data-copy-default="Click the email or phone number to copy it. Use the icons to email or call."
						aria-live="polite"
					>
						Click the email or phone number to copy it. Use the icons to email
						or call.
					</p>
				</div>

				<div class="contact-dialog-socials" aria-label="Social links">
					<a
						href="https://linkedin.com/in/anthonyrosen"
						target="_blank"
						rel="noreferrer"
						aria-label="Anthony Rosen on LinkedIn"
					>
						<Linkedin size={19} strokeWidth={1.8} aria-hidden="true" />
					</a>
				</div>
			</div>
		</section>

		<section
			class="contact-dialog-form-panel"
			aria-labelledby="contact-form-title"
		>
			<div class="contact-dialog-form-heading">
				<p class="contact-dialog-form-kicker">Choose what works for you</p>
				<h3 id="contact-form-title">Let’s connect</h3>
			</div>

			<div
				class="contact-tabs"
				data-contact-tabs
				id="contact-dialog-connect-tabs"
			>
				<div
					class="contact-tab-list"
					role="tablist"
					aria-label="Contact options"
				>
					<button
						type="button"
						role="tab"
						id="contact-dialog-schedule-tab"
						aria-controls="contact-dialog-schedule-panel"
						aria-selected="true"
						data-contact-tab="schedule"
					>
						Schedule a call
					</button>
					<button
						type="button"
						role="tab"
						id="contact-dialog-form-tab"
						aria-controls="contact-dialog-form-panel"
						aria-selected="false"
						tabindex="-1"
						data-contact-tab="form"
					>
						Send a quick note
					</button>
				</div>

				<div
					id="contact-dialog-schedule-panel"
					class="contact-tab-panel"
					role="tabpanel"
					aria-labelledby="contact-dialog-schedule-tab"
					data-contact-panel="schedule"
				>
					<div class="contact-cal-inline" data-cal-inline>
						<p data-cal-loading>Loading available times…</p>
						<a
							href="https://app.cal.com/anthonyrosen/15min"
							data-cal-fallback
							hidden
						>
							Open scheduling in Cal.com
						</a>
					</div>
				</div>

				<form
					id="contact-form"
					class="contact-form"
					role="tabpanel"
					aria-labelledby="contact-dialog-form-tab"
					action={contactEndpoint}
					method="POST"
					data-contact-form
					data-contact-panel="form"
					data-form-location="contact_dialog"
					data-endpoint={contactEndpoint}
					hidden
				>
					<div class="contact-form-field">
						<label for="contact-name">Name</label>
						<input
							id="contact-name"
							name="name"
							type="text"
							autocomplete="name"
							maxlength="80"
							required
							placeholder="Your name"
						/>
					</div>

					<div class="contact-form-field">
						<label for="contact-email">Email</label>
						<input
							id="contact-email"
							name="email"
							type="email"
							autocomplete="email"
							inputmode="email"
							maxlength="120"
							required
							placeholder="you@example.com"
						/>
					</div>

					<div class="contact-form-field">
						<label for="contact-message">What can I help with?</label>
						<textarea
							id="contact-message"
							name="message"
							rows="5"
							minlength="10"
							maxlength="2000"
							required
							placeholder="A little context, a link, or simply what you’re hoping to do."
						></textarea>
					</div>

					<div class="contact-form-honeypot" aria-hidden="true">
						<label for="contact-company-website">Leave this field blank</label>
						<input
							id="contact-company-website"
							name="_gotcha"
							type="text"
							tabindex="-1"
							autocomplete="off"
						/>
					</div>

					<button type="submit" class="contact-form-submit">
						<Send size={17} strokeWidth={1.8} aria-hidden="true" />
						<span data-submit-label>Send message</span>
					</button>
					<p class="contact-form-privacy">
						I’ll only use these details to reply.
					</p>
					<p class="contact-form-status" data-form-status aria-live="polite">
					</p>
				</form>
			</div>
		</section>
	</div>
</dialog>

<script>
	type CalCall = unknown[];
	type CalApi = ((...args: CalCall) => CalApi | void) & { q: CalCall[] };
	type CalGlobal = CalApi & {
		loaded?: boolean;
		ns: Record<string, CalApi>;
		config?: { forwardQueryParams?: boolean };
	};
	type CalWindow = Window & { Cal?: CalGlobal };

	let calEmbedPromise: Promise<void> | null = null;

	function installCalQueue() {
		const calWindow = window as CalWindow;
		if (calWindow.Cal) return calWindow.Cal;

		const enqueue = (api: CalApi, args: CalCall) => api.q.push(args);
		const cal = ((...args: CalCall) => {
			const activeCal = calWindow.Cal;
			if (!activeCal) return;

			if (args[0] === "init") {
				const namespace = args[1];
				const api = ((...namespaceArgs: CalCall) => {
					enqueue(api, namespaceArgs);
				}) as CalApi;
				api.q = [];

				if (typeof namespace === "string") {
					activeCal.ns[namespace] = activeCal.ns[namespace] || api;
					enqueue(activeCal.ns[namespace], args);
					enqueue(activeCal, ["initNamespace", namespace]);
					return activeCal.ns[namespace];
				}
			}

			enqueue(activeCal, args);
		}) as CalGlobal;

		cal.q = [];
		cal.ns = {};
		calWindow.Cal = cal;
		return cal;
	}

	function loadCalEmbed() {
		if (calEmbedPromise) return calEmbedPromise;

		calEmbedPromise = new Promise((resolve, reject) => {
			const Cal = installCalQueue();
			Cal.loaded = true;
			Cal("init", "contact-dialog-15min", {
				origin: "https://app.cal.com",
			});
			Cal("init", "footer-15min", { origin: "https://app.cal.com" });
			Cal.config = Cal.config || {};
			Cal.config.forwardQueryParams = true;
			["contact-dialog-15min", "footer-15min"].forEach((namespace) => {
				Cal.ns[namespace]("ui", {
					hideEventTypeDetails: true,
					layout: "month_view",
				});
			});

			const script = document.createElement("script");
			script.src = "https://app.cal.com/embed/embed.js";
			script.async = true;
			script.addEventListener("load", () => resolve(), { once: true });
			script.addEventListener(
				"error",
				() => reject(new Error("Cal.com failed to load")),
				{
					once: true,
				}
			);
			document.head.appendChild(script);
		});

		return calEmbedPromise;
	}

	async function renderCalInline(container: HTMLElement) {
		if (container.dataset.calRendered === "true") return;
		container.dataset.calRendered = "true";

		try {
			await loadCalEmbed();
			const Cal = installCalQueue();
			const namespace = container.closest("footer")
				? "footer-15min"
				: "contact-dialog-15min";
			Cal.ns[namespace]("inline", {
				elementOrSelector: container,
				calLink: "anthonyrosen/15min",
				config: {
					layout: "month_view",
					useSlotsViewOnSmallScreen: true,
				},
			});
			const loading =
				container.querySelector<HTMLElement>("[data-cal-loading]");
			if (loading) loading.remove();
		} catch {
			container.dataset.calRendered = "false";
			const loading =
				container.querySelector<HTMLElement>("[data-cal-loading]");
			const fallback = container.querySelector<HTMLElement>(
				"[data-cal-fallback]"
			);
			if (loading) loading.textContent = "The scheduler could not load here.";
			fallback?.removeAttribute("hidden");
		}
	}

	function activateContactTab(
		tabsRoot: HTMLElement,
		tabName: string,
		options: { focus?: boolean; track?: boolean } = {}
	) {
		const tabs = Array.from(
			tabsRoot.querySelectorAll<HTMLButtonElement>("[data-contact-tab]")
		);
		const panels = Array.from(
			tabsRoot.querySelectorAll<HTMLElement>("[data-contact-panel]")
		);

		tabs.forEach((tab) => {
			const selected = tab.dataset.contactTab === tabName;
			tab.setAttribute("aria-selected", String(selected));
			tab.tabIndex = selected ? 0 : -1;
			if (selected && options.focus) tab.focus();
		});

		panels.forEach((panel) => {
			panel.hidden = panel.dataset.contactPanel !== tabName;
		});

		if (tabName === "schedule") {
			const calContainer =
				tabsRoot.querySelector<HTMLElement>("[data-cal-inline]");
			if (calContainer) void renderCalInline(calContainer);
			if (options.track) {
				window.dispatchEvent(
					new CustomEvent("cal-scheduler-opened", {
						detail: {
							link_location: tabsRoot.closest("footer")
								? "footer"
								: "contact_dialog",
						},
					})
				);
			}
		}
	}

	function initContactTabs() {
		const tabGroups = document.querySelectorAll<HTMLElement>(
			"[data-contact-tabs]"
		);
		tabGroups.forEach((tabsRoot) => {
			if (tabsRoot.dataset.tabsInitialized === "true") return;
			tabsRoot.dataset.tabsInitialized = "true";

			const tabs = Array.from(
				tabsRoot.querySelectorAll<HTMLButtonElement>("[data-contact-tab]")
			);
			tabs.forEach((tab, index) => {
				tab.addEventListener("click", () => {
					activateContactTab(tabsRoot, tab.dataset.contactTab || "schedule", {
						track: tab.dataset.contactTab === "schedule",
					});
				});

				tab.addEventListener("keydown", (event) => {
					if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) {
						return;
					}
					event.preventDefault();
					let nextIndex = index;
					if (event.key === "ArrowLeft")
						nextIndex = (index - 1 + tabs.length) % tabs.length;
					if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
					if (event.key === "Home") nextIndex = 0;
					if (event.key === "End") nextIndex = tabs.length - 1;
					const nextTab = tabs[nextIndex];
					activateContactTab(
						tabsRoot,
						nextTab.dataset.contactTab || "schedule",
						{
							focus: true,
							track: nextTab.dataset.contactTab === "schedule",
						}
					);
				});
			});

			if (tabsRoot.closest("footer")) {
				const observer = new IntersectionObserver(
					(entries) => {
						if (!entries.some((entry) => entry.isIntersecting)) return;
						activateContactTab(tabsRoot, "schedule");
						observer.disconnect();
					},
					{ rootMargin: "300px" }
				);
				observer.observe(tabsRoot);
			}
		});
	}

	function initContactDialog() {
		const dialog = document.querySelector<HTMLDialogElement>("#contact-dialog");
		if (!dialog || dialog.dataset.initialized === "true") return;
		dialog.dataset.initialized = "true";

		let lastTrigger: HTMLElement | null = null;
		let closeTimer = 0;

		function openDialog(trigger: HTMLElement) {
			lastTrigger = trigger;
			if (!dialog.open) dialog.showModal();
			const tabsRoot = document.getElementById("contact-dialog-connect-tabs");
			if (tabsRoot) activateContactTab(tabsRoot, "schedule");
		}

		function finishClose() {
			window.clearTimeout(closeTimer);
			dialog.classList.remove("is-closing");
			if (dialog.open) dialog.close();
			lastTrigger?.focus();
		}

		function closeDialog() {
			if (!dialog.open || dialog.classList.contains("is-closing")) return;
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				finishClose();
				return;
			}
			dialog.classList.add("is-closing");
			closeTimer = window.setTimeout(finishClose, 180);
		}

		document.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;

			const opener = target.closest<HTMLElement>("[data-contact-dialog-open]");
			if (opener) {
				event.preventDefault();
				openDialog(opener);
				return;
			}

			if (target.closest("[data-contact-dialog-close]")) {
				closeDialog();
				return;
			}
		});

		dialog.addEventListener("cancel", (event) => {
			event.preventDefault();
			closeDialog();
		});

		dialog.addEventListener("click", (event) => {
			if (event.target !== dialog) return;
			const rect = dialog.getBoundingClientRect();
			const inside =
				event.clientX >= rect.left &&
				event.clientX <= rect.right &&
				event.clientY >= rect.top &&
				event.clientY <= rect.bottom;
			if (!inside) closeDialog();
		});

		const copyButtons =
			document.querySelectorAll<HTMLButtonElement>("[data-copy-value]");
		copyButtons.forEach((copyButton) => {
			if (copyButton.dataset.copyInitialized === "true") return;
			copyButton.dataset.copyInitialized = "true";
			let copyResetTimer = 0;

			copyButton.addEventListener("click", async () => {
				const copyValue = copyButton.dataset.copyValue;
				const copyKind = copyButton.dataset.copyKind || "detail";
				const group = copyButton.closest<HTMLElement>("[data-copy-group]");
				const copyArea = copyButton.closest<HTMLElement>("[data-copy-area]");
				const copyStatus =
					group?.querySelector<HTMLElement>("[data-copy-status]") ||
					copyArea?.querySelector<HTMLElement>("[data-copy-status]");
				const copyIcon =
					copyButton.querySelector<SVGElement>("[data-copy-icon]");
				const checkIcon =
					copyButton.querySelector<SVGElement>("[data-check-icon]");
				if (!copyValue) return;

				try {
					await navigator.clipboard.writeText(copyValue);
					if (copyStatus) {
						copyStatus.textContent = `${copyKind === "phone" ? "Phone number" : "Email"} copied to your clipboard.`;
					}
					copyIcon?.setAttribute("hidden", "");
					checkIcon?.removeAttribute("hidden");
					window.dispatchEvent(
						new CustomEvent(`contact-${copyKind}-copied`, {
							detail: {
								link_location: copyButton.dataset.copyLocation || "page",
							},
						})
					);

					window.clearTimeout(copyResetTimer);
					copyResetTimer = window.setTimeout(() => {
						if (copyStatus)
							copyStatus.textContent =
								copyStatus.dataset.copyDefault || "Click to copy.";
						checkIcon?.setAttribute("hidden", "");
						copyIcon?.removeAttribute("hidden");
					}, 2600);
				} catch {
					if (copyStatus) {
						copyStatus.textContent =
							"Copy didn’t work. You can select the text instead.";
					}
				}
			});
		});

		const contactForms = document.querySelectorAll<HTMLFormElement>(
			"[data-contact-form]"
		);
		contactForms.forEach((form) => {
			if (form.dataset.formInitialized === "true") return;
			form.dataset.formInitialized = "true";

			form.addEventListener("submit", async (event) => {
				event.preventDefault();
				const endpoint = form.dataset.endpoint;
				const formStatus =
					form.querySelector<HTMLElement>("[data-form-status]");
				const submitButton = form.querySelector<HTMLButtonElement>(
					"button[type='submit']"
				);
				const submitLabel = form.querySelector<HTMLElement>(
					"[data-submit-label]"
				);
				if (!endpoint || !submitButton || !submitLabel) return;
				if (!form.reportValidity()) return;

				submitButton.disabled = true;
				submitLabel.textContent = "Sending…";
				if (formStatus) formStatus.textContent = "Sending your message.";

				try {
					const response = await fetch(endpoint, {
						method: "POST",
						body: new FormData(form),
						headers: { Accept: "application/json" },
					});

					if (!response.ok) throw new Error("Form submission failed");

					form.reset();
					submitLabel.textContent = "Message sent";
					if (formStatus) {
						formStatus.textContent =
							"Thanks—your message is on its way to Anthony.";
					}
					window.dispatchEvent(
						new CustomEvent("contact-form-sent", {
							detail: {
								link_location: form.dataset.formLocation || "page",
							},
						})
					);
				} catch {
					submitButton.disabled = false;
					submitLabel.textContent = "Try again";
					if (formStatus) {
						formStatus.textContent =
							"That didn’t send. Please try again, or use the email option.";
					}
				}
			});
		});

		initContactTabs();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initContactDialog, {
			once: true,
		});
	} else {
		initContactDialog();
	}
	document.addEventListener("astro:page-load", initContactDialog);
</script>

<style>
	.contact-dialog {
		position: fixed;
		inset: 0;
		width: min(calc(100% - 2rem), 58rem);
		max-width: none;
		max-height: min(90dvh, 48rem);
		padding: 0;
		border: 1px solid rgba(16, 35, 62, 0.12);
		border-radius: 1.5rem;
		background: #fbf7ef;
		box-shadow: 0 32px 90px rgba(2, 10, 23, 0.3);
		color: #10233e;
		overflow: auto;
		margin: auto;
		opacity: 0;
		transform: translateY(10px) scale(0.985);
		transition:
			opacity 180ms ease,
			transform 180ms ease,
			display 180ms allow-discrete,
			overlay 180ms allow-discrete;
	}

	.contact-dialog[open] {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	.contact-dialog.is-closing {
		opacity: 0;
		transform: translateY(8px) scale(0.99);
	}

	@starting-style {
		.contact-dialog[open] {
			opacity: 0;
			transform: translateY(10px) scale(0.985);
		}
	}

	.contact-dialog::backdrop {
		background: rgba(8, 20, 38, 0);
		backdrop-filter: blur(0);
		transition:
			background 180ms ease,
			backdrop-filter 180ms ease,
			display 180ms allow-discrete,
			overlay 180ms allow-discrete;
	}

	.contact-dialog[open]::backdrop {
		background: rgba(8, 20, 38, 0.58);
		backdrop-filter: blur(5px);
	}

	.contact-dialog.is-closing::backdrop {
		background: rgba(8, 20, 38, 0);
		backdrop-filter: blur(0);
	}

	@starting-style {
		.contact-dialog[open]::backdrop {
			background: rgba(8, 20, 38, 0);
			backdrop-filter: blur(0);
		}
	}

	.contact-dialog-shell {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
		min-height: 36rem;
	}

	.contact-dialog-close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		z-index: 2;
		display: inline-flex;
		width: 2.5rem;
		height: 2.5rem;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(16, 35, 62, 0.13);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.78);
		color: #10233e;
		cursor: pointer;
		transition:
			background 150ms ease,
			transform 150ms ease;
	}

	.contact-dialog-close:hover {
		background: white;
		transform: rotate(4deg);
	}

	.contact-dialog-details,
	.contact-dialog-form-panel {
		padding: clamp(2rem, 4.4vw, 3.5rem);
	}

	.contact-dialog-details {
		display: flex;
		flex-direction: column;
		background: #10233e;
		color: white;
	}

	.contact-dialog-eyebrow,
	.contact-dialog-form-kicker {
		margin: 0 0 0.75rem;
		font-family: Inter, system-ui, sans-serif;
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.contact-dialog-eyebrow {
		color: #93c5fd;
	}

	.contact-dialog-details h2 {
		max-width: 8ch;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.35rem, 4.8vw, 3.8rem);
