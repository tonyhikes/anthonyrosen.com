	}

	.dark #portfolio-view[data-portfolio-version="v3"] > div > div > aside {
		border-color: rgba(71, 85, 105, 0.9);
		box-shadow: 0 28px 70px rgba(2, 6, 23, 0.5);
	}

	#portfolio-view[data-portfolio-version="v3"] > div > div > aside::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: linear-gradient(180deg, rgba(96, 165, 250, 0.95), rgba(14, 165, 233, 0.3));
