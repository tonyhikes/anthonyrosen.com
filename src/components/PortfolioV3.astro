			radial-gradient(circle at top left, rgba(59, 130, 246, 0.16), transparent 22%),
			radial-gradient(circle at bottom right, rgba(51, 65, 85, 0.4), transparent 30%),
			linear-gradient(180deg, #020617 0%, #0f172a 40%, #020617 100%);
