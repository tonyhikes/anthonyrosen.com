		position: relative;
		align-self: start;
		border-color: rgba(15, 23, 42, 0.96);
		background:
			linear-gradient(180deg, rgba(15, 23, 42, 0.98), rgba(30, 41, 59, 0.96)),
			radial-gradient(circle at top right, rgba(59, 130, 246, 0.2), transparent 34%);
