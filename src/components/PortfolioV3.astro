---
import PortfolioV2 from "./PortfolioV2.astro";

const previewImages: Record<string, string> = {
	"annual-reports-study": "/portfolio/annual-reports/01.jpg",
	"rxexplorer-study": "/portfolio/rxexplorer-product-brochure/01.jpg",
	"hcqu-study": "/portfolio/hcqu-fact-sheets/01.jpg",
	"whitepaper-study": "/portfolio/whitepaper/01.jpg",
	"pfizer-study": "/portfolio/pfizer-healthy-living/01.jpg",
	"ppt-study": "/portfolio/powerpoint-presentations/01.jpeg",
	"newsletters-study": "/portfolio/newsletters/01.jpg",
	"eap-study": "/portfolio/eap-promos/01.jpg",
	"covers-study": "/portfolio/covers/01.jpg",
	"call-outs-study": "/portfolio/call-outs/01.jpg",
	"story-flows-study": "/portfolio/story-flows/01.jpg",
	"flow-charts-study": "/portfolio/flow-charts/01.jpg",
	"timelines-study": "/portfolio/timelines/01.jpg",
	"graphs-study": "/portfolio/graphs-and-demographics/01.jpg",
	"infographics-study": "/portfolio/infographics/01.jpg",
	"maps-study": "/portfolio/maps/01.jpg",
	"org-charts-study": "/portfolio/org-charts/01.jpg",
	"forms-study": "/portfolio/forms-and-applications/01.jpg",
};
---

<PortfolioV2 portfolioVersion="v3" />

<script define:vars={{ previewImages }}>
	function initPortfolioV3() {
		const root = document.getElementById("portfolio-view");
		if (!root || root.dataset.v3Init === "true") return;

		root.dataset.v3Init = "true";
		root.dataset.portfolioVersion = "v3";

		const renderThumbFallback = () => `
			<span class="v3-thumb-abstract">
				<span></span>
				<span></span>
				<span></span>
				<span></span>
			</span>
		`;

		const bindImageFallbacks = () => {
			root.querySelectorAll("img[data-v3-image]").forEach((image) => {
				if (!(image instanceof HTMLImageElement)) return;
				if (image.dataset.v3Bound === "true") return;
				image.dataset.v3Bound = "true";

				image.addEventListener("error", () => {
					const mode = image.dataset.v3Image;

					if (mode === "thumb") {
						const frame = image.closest(".v2-thumb");
						if (frame instanceof HTMLElement) {
							frame.classList.remove("v3-thumb-has-image");
							frame.classList.add("v3-thumb-fallback");
							frame.innerHTML = renderThumbFallback();
						}
					}

				});
			});
		};

		const hydratePortfolioVisuals = () => {
			if (root.dataset.v3Hydrated === "true") return;
			root.dataset.v3Hydrated = "true";

			root.querySelectorAll(".v2-dir-row").forEach((row) => {
				if (!(row instanceof HTMLElement)) return;
				if (row.dataset.v3ThumbReady === "true") return;

				const thumb = row.querySelector(".v2-thumb");
				const pageTrigger = row.querySelector("[data-v2-page]");
				if (!(thumb instanceof HTMLElement) || !(pageTrigger instanceof HTMLElement)) return;

				const pageId = pageTrigger.dataset.v2Page ?? "";
				const src = previewImages[pageId];
				row.dataset.v3ThumbReady = "true";

				if (src) {
					thumb.classList.add("v3-thumb-has-image");
					thumb.innerHTML = `
						<img
							src="${src}"
							alt=""
							class="v3-thumb-image"
							loading="lazy"
							decoding="async"
							fetchpriority="low"
							data-v3-image="thumb"
						/>
						<span class="v3-thumb-sheen"></span>
					`;
				} else {
					thumb.classList.add("v3-thumb-fallback");
					thumb.innerHTML = renderThumbFallback();
				}
			});

			root.querySelectorAll("#v2-page-overview .v2-entrance").forEach((section) => {
				if (section instanceof HTMLElement) section.classList.add("v2-visible");
			});

			bindImageFallbacks();
		};

		if (window.location.hash === "#portfolio" || !root.classList.contains("hidden")) {
			hydratePortfolioVisuals();
		}

		window.addEventListener("view-change", (event) => {
			if (event && event.detail === "portfolio") {
				hydratePortfolioVisuals();
			}
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initPortfolioV3, { once: true });
	} else {
		initPortfolioV3();
	}

	document.addEventListener("astro:page-load", initPortfolioV3);
</script>

