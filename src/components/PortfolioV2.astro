---
type MediaType = "image" | "video";

type MediaItem = {
	id: string;
	title: string;
	caption: string;
	type: MediaType;
	aspectClass: string;
	src?: string;
	embedUrl?: string;
	badge?: string;
};

type MediaSection = {
	title: string;
	description: string;
	items: MediaItem[];
};

type DirectoryItem = {
	id: string;
	title: string;
	kind: string;
	summary: string;
	detailPage?: string; // links to a case study page ID
};

type CaseStudy = {
	id: string;
	title: string;
	kind: string;
	intro: string;
	meta: { label: string; value: string }[];
	deliverables: string[];
	mediaSections: MediaSection[];
};

const img = (
	id: string,
	title: string,
	caption: string,
	aspectClass: string,
	badge = "Image",
	src?: string
): MediaItem => ({ id, title, caption, type: "image", aspectClass, badge, src });

const vid = (
	id: string,
	title: string,
	caption: string,
	aspectClass: string,
	badge = "Video",
	src?: string,
	embedUrl?: string
): MediaItem => ({ id, title, caption, type: "video", aspectClass, badge, src, embedUrl });

/* Helper: generate image items from a folder */
const folder = (dir: string, files: string[], titles: string[]): MediaItem[] =>
	files.map((f, i) => ({
		id: `${dir}-${i + 1}`,
		title: titles[i] ?? `Image ${i + 1}`,
		caption: "",
		type: "image" as MediaType,
		aspectClass: i === 0 ? "sm:col-span-2" : "",
		badge: "Image",
		src: `/portfolio/${dir}/${f}`,
	}));

