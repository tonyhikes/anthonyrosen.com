	<!-- ═══ LIGHTBOX ═══ -->
	<div
		id="v2-lightbox"
		class="v2-lightbox hidden fixed inset-0 z-[80] bg-slate-950/70 p-4 backdrop-blur-sm sm:p-8"
		role="dialog"
		aria-modal="true"
		aria-label="Portfolio viewer"
	>
		<button id="v2-lightbox-overlay" type="button" class="absolute inset-0" aria-label="Close viewer"></button>
		<div class="v2-lightbox-panel relative mx-auto flex h-full max-w-5xl items-center">
			<div class="grid max-h-full w-full overflow-hidden border border-slate-700 bg-white dark:bg-slate-950 lg:grid-cols-[minmax(0,1fr)_18rem]">
				<div class="border-b border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-900 lg:border-r lg:border-b-0">
					<div id="v2-lightbox-frame" class="flex min-h-[50vh] items-center justify-center p-4 sm:p-8 transition-opacity duration-200">
