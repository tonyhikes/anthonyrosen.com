			{ label: "Type", value: "Visual systems" },
			{ label: "Format", value: "22 assets" },
		],
		deliverables: ["Information graphics", "Visual complexity reduction", "Data storytelling"],
		mediaSections: [
			{
				title: "Infographic designs",
				description: "Complex ideas distilled into clear visual systems.",
				items: Array.from({ length: 11 }, (_, i) => {
					const n = String(i + 1).padStart(2, "0");
					return img(`info-${n}`, `Infographic ${n}`, "", i === 0 ? "sm:col-span-2" : "", "Image", `${P}/infographics/${n}.jpg`);
				}),
			},
			{
				title: "Additional infographics",
				description: "Extended information design and data storytelling.",
				items: Array.from({ length: 11 }, (_, i) => {
					const n = String(i + 12).padStart(2, "0");
					return img(`info-${n}`, `Infographic ${n}`, "", i === 0 ? "sm:col-span-2" : "", "Image", `${P}/infographics/${n}.jpg`);
				}),
			},
		],
	},
	{
		id: "maps-study",
		title: "Maps",
		kind: "Geographic storytelling",
		intro: "Location context and service-area visuals designed for fast orientation.",
		meta: [
			{ label: "Scope", value: "Geographic graphics" },
			{ label: "Type", value: "Service-area maps" },
			{ label: "Format", value: "2 assets" },
		],
		deliverables: ["Service-area maps", "Geographic context", "Location visuals"],
		mediaSections: [{
			title: "Map designs",
			description: "Location context and service-area visualizations.",
			items: Array.from({ length: 2 }, (_, i) => {
				const n = String(i + 1).padStart(2, "0");
				return img(`maps-${n}`, `Map ${n}`, "", i === 0 ? "sm:col-span-2" : "", "Image", `${P}/maps/${n}.jpg`);
			}),
		}],
	},
	{
		id: "org-charts-study",
		title: "Org Charts",
		kind: "Stakeholder clarity",
		intro: "Role and reporting structures that keep reviewers oriented as complexity grows.",
		meta: [
			{ label: "Scope", value: "Organizational graphics" },
			{ label: "Type", value: "Reporting structures" },
			{ label: "Format", value: "7 assets" },
		],
		deliverables: ["Org chart systems", "Reporting hierarchies", "Role clarity design"],
		mediaSections: [{
			title: "Organizational charts",
			description: "Role and reporting structures for complex organizations.",
			items: Array.from({ length: 7 }, (_, i) => {
				const n = String(i + 1).padStart(2, "0");
				return img(`orgcharts-${n}`, `Org chart ${n}`, "", i === 0 ? "sm:col-span-2" : "", "Image", `${P}/org-charts/${n}.jpg`);
			}),
		}],
	},
	{
		id: "forms-study",
		title: "Forms & Applications",
		kind: "Functional design",
		intro: "Working documents that stay usable and on-brand at the same time.",
		meta: [
			{ label: "Scope", value: "Functional documents" },
			{ label: "Type", value: "Forms and applications" },
			{ label: "Format", value: "4 assets" },
		],
		deliverables: ["Form design", "Application layouts", "Functional branding"],
		mediaSections: [{
			title: "Form and application designs",
			description: "Functional documents that balance usability and brand consistency.",
			items: Array.from({ length: 4 }, (_, i) => {
				const n = String(i + 1).padStart(2, "0");
				return img(`forms-${n}`, `Form ${n}`, "", i === 0 ? "sm:col-span-2" : "", "Image", `${P}/forms-and-applications/${n}.jpg`);
			}),
		}],
	},
];

const hiddenCaseStudyIds = new Set(["kepro-video-study", "rxexplorer-study"]);
const visibleMarketingItems = marketingItems.filter(
	(item) => !hiddenMarketingItemIds.has(item.id)
);
const visibleCaseStudies = caseStudies.filter(
	(study) => !hiddenCaseStudyIds.has(study.id)
);

/* ─── TOC structure ─── */

const tocSections = [
	{
		label: "Publishing",
		target: "overview-publishing",
	},
	{
		label: "Marketing",
		target: "sec-marketing",
		count: visibleMarketingItems.length,
		children: visibleMarketingItems.map((item) => ({
			label: item.title,
			target: item.detailPage ?? item.id,
			isPage: !!item.detailPage,
		})),
	},
	{
		label: "Proposal",
		target: "sec-proposal",
		count: proposalItems.length,
		children: proposalItems.map((item) => ({
			label: item.title,
			target: item.detailPage ?? item.id,
			isPage: !!item.detailPage,
		})),
	},
	{
		label: "Contact",
		target: "sec-contact",
	},
];

const totalPieces = visibleMarketingItems.length + proposalItems.length;
const { portfolioVersion } = Astro.props;
---

<div
	id="portfolio-view"
	data-portfolio-version={portfolioVersion}
	class="hidden min-h-screen bg-slate-50 text-slate-900 transition-colors duration-300 dark:bg-slate-950 dark:text-white"
>
	<div class="mx-auto max-w-[92rem] px-4 pt-24 pb-20 sm:px-6 lg:px-8">
		<div class="grid gap-8 xl:grid-cols-[17rem_minmax(0,1fr)]">

			<!-- ═══ LEFT SIDEBAR TOC ═══ -->
			<aside class="hidden xl:flex xl:sticky xl:top-24 xl:h-[calc(100vh-7rem)] xl:flex-col xl:overflow-hidden border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
				<!-- Header -->
				<div class="border-b border-slate-200 px-5 py-5 dark:border-slate-800">
					<div class="flex items-center justify-between gap-4">
						<div class="flex items-center gap-3">
							<div class="flex h-10 w-10 items-center justify-center bg-slate-900 text-sm font-black tracking-[0.18em] text-white dark:bg-white dark:text-slate-950">
								AR
							</div>
							<div>
								<p class="text-[11px] font-semibold tracking-[0.24em] text-slate-400 uppercase">Portfolio</p>
								<p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Anthony Rosen</p>
							</div>
						</div>
						<button
							type="button"
							data-v2-nav="home"
							class="border border-slate-200 px-2.5 py-1 text-[11px] font-semibold tracking-[0.24em] text-slate-500 uppercase transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:text-slate-300 dark:hover:border-blue-400 dark:hover:text-blue-300"
						>
							Back
						</button>
					</div>
				</div>

				<!-- Scrollable TOC -->
				<div
					class="v2-toc-scroll min-h-0 flex-1 overflow-y-scroll overflow-x-hidden px-5 py-5 pr-3"
					data-lenis-prevent
					tabindex="0"
					aria-label="Portfolio table of contents"
				>
					<div class="space-y-5">
						<!-- Overview link -->
						<button
							type="button"
							data-v2-page="overview"
							class="v2-toc-item w-full text-left text-[14px] font-semibold text-blue-600 transition hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
						>
							Overview
						</button>

						{tocSections.map((group) => (
							<div>
								{!group.children ? (
									<button
										type="button"
										data-v2-page={group.isPage ? group.target : undefined}
										data-v2-scroll={!group.isPage ? group.target : undefined}
										class="v2-toc-item w-full text-left text-[14px] font-medium text-slate-500 transition hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-300"
									>
										{group.label}
									</button>
								) : (
									<div>
										<div class="mb-3 flex items-center justify-between gap-4">
											<button
												type="button"
												data-v2-scroll={group.target}
												class="v2-toc-item text-left text-[11px] font-black tracking-[0.18em] text-slate-900 uppercase transition hover:text-blue-600 dark:text-white dark:hover:text-blue-300"
											>
												{group.label}
											</button>
											<span class="text-xs font-semibold text-slate-400">{group.count}</span>
										</div>
										<div class="space-y-1.5 border-l border-slate-200 pl-4 dark:border-slate-800">
											{group.children.map((child) => (
												<button
													type="button"
													data-v2-page={child.isPage ? child.target : undefined}
													data-v2-scroll={!child.isPage ? child.target : undefined}
													class="v2-toc-item block w-full text-left text-[14px] leading-6 text-slate-400 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
												>
													{child.label}
												</button>
											))}
										</div>
									</div>
								)}
							</div>
						))}
					</div>
				</div>

				<!-- Stat footer -->
				<div class="border-t border-slate-200 px-5 py-4 dark:border-slate-800">
					<div class="flex items-center justify-between text-sm">
						<span class="font-semibold text-slate-700 dark:text-slate-200">{totalPieces} projects</span>
						<span class="text-slate-400">{visibleCaseStudies.length} case studies</span>
					</div>
				</div>
			</aside>

			<!-- ═══ MAIN CONTENT AREA ═══ -->
			<main class="min-w-0">

				<!-- ─── OVERVIEW PAGE ─── -->
				<div id="v2-page-overview" data-v2-view="overview">

					<!-- Hero -->
					<section class="border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
						<div class="p-6 lg:p-8">
							<div class="v3-hero-copy">
								<p class="text-[11px] font-semibold tracking-[0.24em] text-blue-600 uppercase dark:text-blue-400">Portfolio</p>
								<h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl dark:text-white">
									Selected Work
								</h1>
								<p class="mt-4 max-w-3xl text-base leading-7 text-slate-600 dark:text-slate-300">
									Design and communications work spanning editorial systems, marketing campaigns, proposals, and motion. Select a project below or use the sidebar to navigate.
								</p>
							</div>
						</div>
						<div class="grid grid-cols-3 gap-px border-t border-slate-200 bg-slate-200 dark:border-slate-800 dark:bg-slate-800">
							<div class="bg-white p-4 dark:bg-slate-900">
								<p class="text-2xl font-black tracking-tight text-slate-950 dark:text-white">{totalPieces}</p>
								<p class="mt-1 text-[11px] font-semibold tracking-[0.24em] text-slate-400 uppercase">Projects</p>
							</div>
							<div class="bg-white p-4 dark:bg-slate-900">
								<p class="text-2xl font-black tracking-tight text-slate-950 dark:text-white">{visibleCaseStudies.length}</p>
								<p class="mt-1 text-[11px] font-semibold tracking-[0.24em] text-slate-400 uppercase">Case studies</p>
							</div>
							<div class="bg-white p-4 dark:bg-slate-900">
								<p class="text-2xl font-black tracking-tight text-slate-950 dark:text-white">10+</p>
								<p class="mt-1 text-[11px] font-semibold tracking-[0.24em] text-slate-400 uppercase">Years</p>
							</div>
						</div>
					</section>

					<!-- Mobile quick-jump -->
					<div class="xl:hidden mt-5 border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
						<p class="text-[11px] font-semibold tracking-[0.24em] text-slate-400 uppercase">Jump to</p>
						<div class="mt-3 flex gap-2 overflow-x-auto v2-scrollbar-hide pb-1">
							<button type="button" data-v2-scroll="overview-publishing" class="shrink-0 border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-300">Publishing</button>
							<button type="button" data-v2-scroll="sec-marketing" class="shrink-0 border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-300">Marketing</button>
							<button type="button" data-v2-scroll="sec-proposal" class="shrink-0 border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-300">Proposal</button>
							<button type="button" data-v2-scroll="sec-contact" class="shrink-0 border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-300">Contact</button>
						</div>
					</div>

					<!-- Publishing feature card -->
					<section
						id="overview-publishing"
						class="v2-entrance mt-8 border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900"
					>
						<div class="border-b border-slate-200 px-6 py-5 dark:border-slate-800 lg:px-8">
							<p class="text-[11px] font-semibold tracking-[0.24em] text-blue-600 uppercase dark:text-blue-400">{publishing.kicker}</p>
							<h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 dark:text-white">{publishing.title}</h2>
						</div>
						<div class="grid gap-px border-t border-slate-200 bg-slate-200 dark:border-slate-800 dark:bg-slate-800 lg:grid-cols-[minmax(0,1.25fr)_repeat(3,minmax(0,0.75fr))]">
							<div class="bg-white p-6 dark:bg-slate-900 lg:p-8">
								<p class="max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-300">{publishing.summary}</p>
								<ul class="mt-5 space-y-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
									{publishing.points.map((point) => (
										<li class="flex gap-3">
											<span class="mt-2 h-2 w-2 shrink-0 bg-blue-600 dark:bg-blue-400"></span>
											<span>{point}</span>
										</li>
									))}
								</ul>
							</div>
							{publishing.stats.map((stat) => (
								<div class="bg-white p-6 dark:bg-slate-900">
									<p class="text-3xl font-black tracking-tight text-slate-950 dark:text-white">{stat.value}</p>
									<p class="mt-2 text-[11px] font-semibold tracking-[0.24em] text-slate-400 uppercase">{stat.label}</p>
								</div>
							))}
						</div>
						<div class="grid grid-cols-3 gap-px border-t border-slate-200 bg-slate-200 dark:border-slate-800 dark:bg-slate-800">
							{publishing.highlights.map((h) => (
								<div class="bg-slate-50 p-5 dark:bg-slate-900">
									<p class="text-xl font-black tracking-tight text-slate-950 dark:text-white">{h.value}</p>
									<p class="mt-1 text-xs font-semibold text-slate-400 uppercase tracking-[0.18em]">{h.label}</p>
								</div>
							))}
						</div>
						<div class="border-t border-slate-200 dark:border-slate-800">
							<div class="flex items-end justify-between gap-4 px-6 py-5 dark:border-slate-800 lg:px-8">
								<div>
									<h3 class="text-lg font-bold tracking-tight text-slate-950 dark:text-white">Science Magazine work</h3>
									<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Selected editorial, digital, and publishing-operations work.</p>
								</div>
								<p class="text-xs font-semibold tracking-[0.18em] text-slate-400 uppercase">{publishingMedia.length} images</p>
							</div>
							<div class="grid gap-3 p-5 sm:grid-cols-2 lg:grid-cols-3">
								{publishingMedia.map((item, idx) => (
									<button
										type="button"
										data-v2-lightbox
										data-v2-group={publishing.id}
										data-v2-index={String(idx)}
										data-v2-title={item.title}
										data-v2-caption={item.caption}
										data-v2-type={item.type}
										data-v2-src={item.src ?? ""}
										data-v2-embed={item.embedUrl ?? ""}
										data-v2-badge={item.badge ?? ""}
										class:list={[
											"v2-media-tile group border border-slate-200 text-left transition hover:border-blue-600 dark:border-slate-800 dark:hover:border-blue-400",
											item.aspectClass,
										]}
									>
										<div class="flex h-full flex-col">
											<div class="flex min-h-44 flex-1 items-center justify-center bg-slate-100 p-2 dark:bg-slate-900">
												<img
													src={item.src}
												alt={item.title}
												class="max-h-72 w-full object-contain"
												loading="lazy"
												decoding="async"
												fetchpriority="low"
											/>
											</div>
											<div class="border-t border-slate-200 px-4 py-3 dark:border-slate-800">
												<p class="text-sm font-semibold text-slate-700 group-hover:text-blue-600 dark:text-slate-200 dark:group-hover:text-blue-300">{item.title}</p>
											</div>
										</div>
									</button>
								))}
							</div>
						</div>
					</section>

					<!-- Marketing directory -->
					<section id="sec-marketing" class="v2-entrance mt-8 border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
						<div class="border-b border-slate-200 px-6 py-5 dark:border-slate-800 lg:px-8">
							<div class="flex items-end justify-between gap-4">
								<div>
									<p class="text-[11px] font-semibold tracking-[0.24em] text-slate-400 uppercase">Section 01</p>
									<h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 dark:text-white">Marketing</h2>
								</div>
								<p class="text-sm text-slate-400">{visibleMarketingItems.length} projects</p>
							</div>
						</div>
						<div class="divide-y divide-slate-200 dark:divide-slate-800">
							{visibleMarketingItems.map((item, i) => (
								<div class="v2-dir-row group grid items-center gap-4 px-6 py-4 transition grid-cols-[4rem_minmax(0,1fr)_auto] lg:grid-cols-[4rem_minmax(0,1fr)_minmax(0,1.2fr)_10rem_auto] lg:px-8 hover:bg-slate-50 dark:hover:bg-slate-800/50">
									<!-- Thumbnail placeholder -->
									<div class="v2-thumb h-14 w-16 border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800 overflow-hidden flex items-center justify-center">
										<div class="grid h-8 w-10 grid-cols-2 gap-0.5">
											<div class="bg-slate-200 dark:bg-slate-600"></div>
											<div class="bg-slate-200 dark:bg-slate-600"></div>
											<div class="col-span-2 bg-blue-600/15 dark:bg-blue-400/20"></div>
										</div>
									</div>
									<div>
										<h3 class="text-base font-bold tracking-tight text-slate-950 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-300">
											{item.title}
										</h3>
										<p class="mt-0.5 text-xs font-semibold tracking-[0.18em] text-slate-400 uppercase">
											{item.kind}
										</p>
									</div>
									<p class="hidden text-sm leading-6 text-slate-500 dark:text-slate-400 lg:block">{item.summary}</p>
									<span class="hidden text-xs font-semibold tracking-[0.18em] text-slate-400 uppercase lg:block">
										{String(i + 1).padStart(2, "0")}
									</span>
									{item.detailPage ? (
										<button
											type="button"
											data-v2-page={item.detailPage}
											class="text-sm font-semibold text-blue-600 transition hover:text-blue-700 dark:text-blue-300 dark:hover:text-blue-200"
										>
											View &rarr;
										</button>
									) : (
										<span class="text-xs text-slate-300 dark:text-slate-600">&mdash;</span>
									)}
								</div>
							))}
						</div>
					</section>

					<!-- Proposal directory -->
					<section id="sec-proposal" class="v2-entrance mt-8 border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
						<div class="border-b border-slate-200 px-6 py-5 dark:border-slate-800 lg:px-8">
							<div class="flex items-end justify-between gap-4">
								<div>
									<p class="text-[11px] font-semibold tracking-[0.24em] text-slate-400 uppercase">Section 02</p>
									<h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 dark:text-white">Proposal</h2>
								</div>
								<p class="text-sm text-slate-400">{proposalItems.length} projects</p>
							</div>
						</div>
						<div class="divide-y divide-slate-200 dark:divide-slate-800">
							{proposalItems.map((item, i) => (
								<div class="v2-dir-row group grid items-center gap-4 px-6 py-4 transition grid-cols-[4rem_minmax(0,1fr)_auto] lg:grid-cols-[4rem_minmax(0,1fr)_minmax(0,1.2fr)_10rem_auto] lg:px-8 hover:bg-slate-50 dark:hover:bg-slate-800/50">
									<!-- Thumbnail placeholder -->
									<div class="v2-thumb h-14 w-16 border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800 overflow-hidden flex items-center justify-center">
										<div class="grid h-8 w-10 grid-cols-2 gap-0.5">
											<div class="col-span-2 bg-slate-200 dark:bg-slate-600"></div>
											<div class="bg-slate-200 dark:bg-slate-600"></div>
											<div class="bg-blue-600/15 dark:bg-blue-400/20"></div>
										</div>
									</div>
									<div>
										<h3 class="text-base font-bold tracking-tight text-slate-950 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-300">
											{item.title}
										</h3>
										<p class="mt-0.5 text-xs font-semibold tracking-[0.18em] text-slate-400 uppercase">
											{item.kind}
										</p>
									</div>
									<p class="hidden text-sm leading-6 text-slate-500 dark:text-slate-400 lg:block">{item.summary}</p>
									<span class="hidden text-xs font-semibold tracking-[0.18em] text-slate-400 uppercase lg:block">
										{String(i + 1).padStart(2, "0")}
									</span>
									{item.detailPage ? (
										<button
											type="button"
											data-v2-page={item.detailPage}
