</div>

<script>
	function initPortfolioV2() {
		const root = document.getElementById("portfolio-view");
		if (!root || root.dataset.v2Init === "true") return;
		root.dataset.v2Init = "true";

		const $$ = (sel: string): HTMLButtonElement[] =>
			Array.from(root.querySelectorAll(sel)).filter(
				(el) => el instanceof HTMLButtonElement
			) as HTMLButtonElement[];
		const hydrateStudyMedia = (pageId: string) => {
			const host = root.querySelector(
				`[data-v2-study-media-host="${pageId}"]`
			) as HTMLElement | null;
			const template = root.querySelector(
				`template[data-v2-study-media-template="${pageId}"]`
			) as HTMLTemplateElement | null;

			if (!host || !template || host.dataset.v2Hydrated === "true") return;

			host.appendChild(template.content.cloneNode(true));
			host.dataset.v2Hydrated = "true";
		};

		const views = root.querySelectorAll<HTMLElement>("[data-v2-view]");
		const tocScroll = root.querySelector(".v2-toc-scroll");
		let currentView = "overview";
		let lastTocScrollTop = tocScroll instanceof HTMLElement ? tocScroll.scrollTop : 0;
		const isDesktopTocButton = (button: HTMLButtonElement) =>
			button.closest(".v2-toc-scroll") !== null;
		const getTocScrollTop = (button?: HTMLButtonElement | null) =>
			tocScroll instanceof HTMLElement && button && isDesktopTocButton(button)
				? lastTocScrollTop
				: null;
		const restoreTocScrollTop = (scrollTop: number | null) => {
			if (!(tocScroll instanceof HTMLElement) || scrollTop === null) return;
			lastTocScrollTop = scrollTop;
			tocScroll.scrollTop = scrollTop;
			requestAnimationFrame(() => {
				tocScroll.scrollTop = scrollTop;
			});
			window.setTimeout(() => {
				tocScroll.scrollTop = scrollTop;
			}, 80);
			window.setTimeout(() => {
				tocScroll.scrollTop = scrollTop;
			}, 220);
		};

		/* ─── Page switching ─── */

		const showPage = (
			pageId: string,
			options: { tocScrollTop?: number | null } = {}
		) => {
			hydrateStudyMedia(pageId);
			currentView = pageId;
			views.forEach((v) => {
				const isTarget = v.dataset.v2View === pageId;
				v.classList.toggle("hidden", !isTarget);
			});

			// Scroll to top of portfolio
			const portfolioTop = root.getBoundingClientRect().top + window.scrollY - 80;
			window.scrollTo({ top: portfolioTop, behavior: "smooth" });

			// Update TOC active states
			root.querySelectorAll(".v2-toc-item").forEach((item) => {
				const el = item as HTMLElement;
				const target = el.dataset.v2Page ?? el.dataset.v2Scroll;
				const isActive = target === pageId;
				el.classList.toggle("v2-toc-active", isActive);
			});

			// Re-observe entrance animations on the new page
			if (!prefersReduced) {
				const pageEl = root.querySelector(`[data-v2-view="${pageId}"]`);
				if (pageEl) {
					pageEl.querySelectorAll(".v2-entrance:not(.v2-visible)").forEach((el) => {
						entranceObserver.observe(el);
					});
				}
			}

			restoreTocScrollTop(options.tocScrollTop ?? null);
		};

		if (tocScroll instanceof HTMLElement) {
			tocScroll.addEventListener("scroll", () => {
				lastTocScrollTop = tocScroll.scrollTop;
			});

			tocScroll.addEventListener(
				"wheel",
				(event) => {
					if (tocScroll.scrollHeight <= tocScroll.clientHeight) return;
					tocScroll.scrollTop += event.deltaY;
					lastTocScrollTop = tocScroll.scrollTop;
					event.preventDefault();
					event.stopPropagation();
				},
				{ passive: false }
			);
		}

		$$("[data-v2-page]").forEach((btn) => {
			btn.addEventListener("pointerdown", () => {
				if (tocScroll instanceof HTMLElement && isDesktopTocButton(btn)) {
					lastTocScrollTop = tocScroll.scrollTop;
				}
			});

			btn.addEventListener("click", () => {
				const pageId = btn.dataset.v2Page;
				if (pageId) {
					showPage(pageId, { tocScrollTop: getTocScrollTop(btn) });
					btn.blur();
				}
			});
		});

		/* ─── Scroll within overview ─── */

		$$("[data-v2-scroll]").forEach((btn) => {
			btn.addEventListener("pointerdown", () => {
				if (tocScroll instanceof HTMLElement && isDesktopTocButton(btn)) {
					lastTocScrollTop = tocScroll.scrollTop;
				}
			});

			btn.addEventListener("click", () => {
				const targetId = btn.dataset.v2Scroll;
				if (!targetId) return;
				const tocScrollTop = getTocScrollTop(btn);

				// If we're not on overview and the target is an overview section, go to overview first
				if (currentView !== "overview" && !document.getElementById(`v2-page-${targetId}`)) {
					showPage("overview", { tocScrollTop });
					setTimeout(() => {
						const el = document.getElementById(targetId);
						if (el) {
							const top = el.getBoundingClientRect().top + window.scrollY - 128;
							window.scrollTo({ top, behavior: "smooth" });
						}
						restoreTocScrollTop(tocScrollTop);
					}, 100);
				} else {
					const el = document.getElementById(targetId);
					if (el) {
						const top = el.getBoundingClientRect().top + window.scrollY - 128;
						window.scrollTo({ top, behavior: "smooth" });
					}
					restoreTocScrollTop(tocScrollTop);
				}
				btn.blur();
			});
		});

		/* ─── Back to home ─── */

		$$("[data-v2-nav]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const target = btn.dataset.v2Nav;
				if (target) window.dispatchEvent(new CustomEvent("view-change", { detail: target }));
			});
		});

		/* ─── Entrance animations ─── */

		const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		let entranceObserver: IntersectionObserver;

		if (!prefersReduced) {
			entranceObserver = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							(entry.target as HTMLElement).classList.add("v2-visible");
							entranceObserver.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.08, rootMargin: "0px 0px -30px 0px" }
			);
			root.querySelectorAll(".v2-entrance").forEach((el) => entranceObserver.observe(el));
		} else {
			root.querySelectorAll(".v2-entrance").forEach((el) => el.classList.add("v2-visible"));
		}

		/* ─── Lightbox ─── */

		const modal = document.getElementById("v2-lightbox");
		const overlay = document.getElementById("v2-lightbox-overlay");
		const closeBtn = document.getElementById("v2-lightbox-close");
		const prevBtn = document.getElementById("v2-lightbox-prev") as HTMLButtonElement | null;
		const nextBtn = document.getElementById("v2-lightbox-next") as HTMLButtonElement | null;
		const lbBadge = document.getElementById("v2-lightbox-badge");
		const lbTitle = document.getElementById("v2-lightbox-title");
		const lbCaption = document.getElementById("v2-lightbox-caption");
		const lbCount = document.getElementById("v2-lightbox-count");
		const lbImg = document.getElementById("v2-lightbox-img") as HTMLImageElement | null;
		const lbVideo = document.getElementById("v2-lightbox-video") as HTMLIFrameElement | null;
		const lbEmpty = document.getElementById("v2-lightbox-empty");
		const lbEmptyBadge = document.getElementById("v2-lightbox-empty-badge");
		const lbEmptyNote = document.getElementById("v2-lightbox-empty-note");
		const lbFrame = document.getElementById("v2-lightbox-frame");

		if (!modal || !overlay || !closeBtn || !prevBtn || !nextBtn || !lbBadge || !lbTitle || !lbCaption || !lbCount || !lbImg || !lbVideo || !lbEmpty || !lbEmptyBadge || !lbEmptyNote || !lbFrame) return;

		let groupButtons: HTMLButtonElement[] = [];
		let activeIdx = 0;
		let triggerButton: HTMLButtonElement | null = null;

		const getGroup = (name: string) => $$(`[data-v2-lightbox][data-v2-group="${name}"]`);

		const render = () => {
			const btn = groupButtons[activeIdx];
			if (!btn) return;

			lbBadge.textContent = btn.dataset.v2Badge ?? "";
			lbTitle.textContent = btn.dataset.v2Title ?? "";
			lbCaption.textContent = btn.dataset.v2Caption ?? "";
			lbCount.textContent = `${activeIdx + 1} / ${groupButtons.length}`;

			lbFrame.style.opacity = "0";
			setTimeout(() => {
				lbImg.classList.add("hidden");
				lbVideo.classList.add("hidden");
				lbEmpty.classList.add("hidden");
				lbImg.src = "";
				lbVideo.src = "";

				const type = btn.dataset.v2Type ?? "image";
				const src = btn.dataset.v2Src ?? "";
				const embed = btn.dataset.v2Embed ?? "";

				if (type === "image" && src) {
					lbImg.src = src;
					lbImg.alt = btn.dataset.v2Title ?? "";
					lbImg.classList.remove("hidden");
				} else if (type === "video" && embed) {
					lbVideo.src = embed;
					lbVideo.classList.remove("hidden");
				} else {
					lbEmpty.classList.remove("hidden");
					lbEmptyBadge.textContent = btn.dataset.v2Badge ?? "";
					lbEmptyNote.textContent = type === "video"
						? "Video embed will appear here once the final URL is added."
						: "Image will appear here once the portfolio asset is added.";
				}
				lbFrame.style.opacity = "1";
			}, 150);

			prevBtn.disabled = activeIdx === 0;
			nextBtn.disabled = activeIdx === groupButtons.length - 1;
		};

		const openLightbox = (btn: HTMLButtonElement) => {
			const group = btn.dataset.v2Group;
			if (!group) return;
			triggerButton = btn;
			groupButtons = getGroup(group);
			activeIdx = groupButtons.indexOf(btn);
			if (activeIdx < 0) activeIdx = 0;
			render();
			modal.classList.remove("hidden");
			modal.classList.add("v2-lightbox-entering");
			document.documentElement.classList.add("overflow-hidden");
			setTimeout(() => {
				modal.classList.remove("v2-lightbox-entering");
				closeBtn?.focus();
			}, 280);
		};

		const closeLightbox = () => {
			modal.classList.add("v2-lightbox-leaving");
			setTimeout(() => {
				modal.classList.add("hidden");
				modal.classList.remove("v2-lightbox-leaving");
				document.documentElement.classList.remove("overflow-hidden");
				lbVideo.src = "";
				triggerButton?.focus();
			}, 220);
		};

		root.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const btn = target.closest("[data-v2-lightbox]");
			if (btn instanceof HTMLButtonElement) openLightbox(btn);
		});

		prevBtn.addEventListener("click", () => { if (activeIdx > 0) { activeIdx--; render(); } });
		nextBtn.addEventListener("click", () => { if (activeIdx < groupButtons.length - 1) { activeIdx++; render(); } });
		closeBtn.addEventListener("click", closeLightbox);
		overlay.addEventListener("click", closeLightbox);

		modal.addEventListener("keydown", (e: KeyboardEvent) => {
			if (e.key === "Escape") { closeLightbox(); return; }
			if (e.key === "ArrowLeft" && !prevBtn.disabled) { activeIdx--; render(); return; }
			if (e.key === "ArrowRight" && !nextBtn.disabled) { activeIdx++; render(); return; }
			if (e.key === "Tab") {
				const focusable = Array.from(modal.querySelectorAll<HTMLElement>(
					'button:not([disabled]):not(.hidden), [href], [tabindex]:not([tabindex="-1"])'
				)).filter((el) => !el.closest(".hidden") && el.offsetParent !== null);
				if (focusable.length === 0) return;
				const first = focusable[0];
				const last = focusable[focusable.length - 1];
				if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
				else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
			}
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initPortfolioV2, { once: true });
	} else {
		initPortfolioV2();
	}
	document.addEventListener("astro:page-load", initPortfolioV2);
</script>

