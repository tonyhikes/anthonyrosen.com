					</section>

					<!-- Contact -->
					<section id="sec-contact" class="v2-entrance mt-8 border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
						<div class="grid gap-px bg-slate-200 dark:bg-slate-800 lg:grid-cols-[minmax(0,1fr)_18rem]">
							<div class="bg-white p-6 dark:bg-slate-900 lg:p-8">
								<p class="text-[11px] font-semibold tracking-[0.24em] text-slate-400 uppercase">Contact</p>
