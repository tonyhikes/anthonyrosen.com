																<div class="v2-placeholder flex flex-1 items-center justify-center bg-slate-50 p-6 dark:bg-slate-900/50">
																	<div class="text-center">
																		<div class="mx-auto mb-3 h-px w-10 bg-blue-600 dark:bg-blue-400"></div>
																		{item.type === "video" ? (
																			<div class="mx-auto flex h-10 w-10 items-center justify-center border border-slate-300 dark:border-slate-600">
																				<div class="h-0 w-0 border-y-[6px] border-l-[10px] border-y-transparent border-l-slate-400 ml-0.5 dark:border-l-slate-500"></div>
