							<p id="v2-lightbox-empty-note" class="mt-3 text-sm leading-7 text-slate-500 dark:text-slate-400"></p>
						</div>
					</div>
				</div>
				<div class="grid">
					<div class="border-b border-slate-200 px-5 py-4 dark:border-slate-800">
						<div class="flex items-start justify-between gap-4">
							<div>
								<p id="v2-lightbox-badge" class="text-[11px] font-semibold tracking-[0.24em] text-slate-400 uppercase"></p>
								<h3 id="v2-lightbox-title" class="mt-2 text-xl font-bold tracking-tight text-slate-950 dark:text-white"></h3>
							</div>
							<button id="v2-lightbox-close" type="button" class="border border-slate-200 px-2.5 py-1 text-[11px] font-semibold tracking-[0.24em] text-slate-500 uppercase transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:text-slate-300 dark:hover:border-blue-400 dark:hover:text-blue-300">Close</button>
						</div>
					</div>
					<div class="px-5 py-5">
						<p id="v2-lightbox-caption" class="text-sm leading-7 text-slate-600 dark:text-slate-300"></p>
					</div>
					<div class="mt-auto grid gap-px border-t border-slate-200 bg-slate-200 dark:border-slate-800 dark:bg-slate-800">
						<div class="bg-white px-5 py-3 text-xs font-semibold tracking-[0.24em] text-slate-400 uppercase dark:bg-slate-950">
							<span id="v2-lightbox-count"></span>
						</div>
						<div class="grid grid-cols-2 gap-px bg-slate-200 dark:bg-slate-800">
							<button id="v2-lightbox-prev" type="button" class="bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:text-blue-600 disabled:cursor-not-allowed disabled:text-slate-300 dark:bg-slate-950 dark:text-slate-200 dark:hover:text-blue-300 dark:disabled:text-slate-600">Previous</button>
							<button id="v2-lightbox-next" type="button" class="bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:text-blue-600 disabled:cursor-not-allowed disabled:text-slate-300 dark:bg-slate-950 dark:text-slate-200 dark:hover:text-blue-300 dark:disabled:text-slate-600">Next</button>
						</div>
					</div>
				</div>
