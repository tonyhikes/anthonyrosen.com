---
// Career timeline on the homepage. No dates, images or per-job links yet:
// career pages don't exist, so the portfolio is the one place to see the work.
const experiences = [
	{
		title: "Product & Marketing Manager",
		company: "ACR Electronics, Inc.",
		description:
			"Managed marketing for Bivy (satellite comms). Oversaw FCC/CE regulatory compliance, localization for 20+ countries, and reduced production costs by 8%.",
	},
	{
		title: "Proposal & Marketing Coordinator",
		company: "Kepro Healthcare CM & QIO",
		description:
			"Directed creative production for 30+ healthcare proposals. Managed global localization for Pfizer campaigns across 88 countries.",
	},
	{
		title: "Senior Content Specialist",
		company: "AAAS (Science Magazine)",
		description:
			"Saved ~$50K annually in print costs. Coordinated design/editorial teams for mobile app launch to 30,000+ readers.",
	},
];
---

<section
	id="work-overview"
	aria-labelledby="career-heading"
	class="bg-slate-50 pt-24 transition-colors duration-300 md:pt-28 dark:bg-[#0B1120]"
>
	<div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
		<div
			class="mb-12 flex flex-wrap items-end justify-between gap-x-8 gap-y-3 md:mb-14"
		>
			<div>
				<p
					class="mb-2.5 text-[13px] font-semibold tracking-[0.1em] text-slate-600 uppercase dark:text-slate-400"
				>
					Career
				</p>
				<h2
					id="career-heading"
					class="font-display text-4xl leading-tight text-slate-900 md:text-[44px] dark:text-white"
				>
					Proven experience
				</h2>
			</div>
			<a
				href="/#portfolio"
				data-target="portfolio"
				class="nav-link font-semibold text-slate-900 underline-offset-[6px] hover:underline dark:text-white"
			>
				Browse the full portfolio <span aria-hidden="true">→</span>
			</a>
		</div>

		<ol
			class="relative before:absolute before:top-2.5 before:bottom-2.5 before:left-[5px] before:w-px before:bg-slate-200 dark:before:bg-slate-800"
		>
			{
				experiences.map((exp) => (
					<li class="relative pb-14 pl-12 last:pb-0">
						<span
							class="absolute top-3 left-0 h-3 w-3 rounded-full border-2 border-slate-50 bg-[#1f2a47] dark:border-[#0B1120] dark:bg-slate-300"
							aria-hidden="true"
						/>
						<h3 class="text-2xl leading-snug font-bold text-slate-900 md:text-[26px] dark:text-white">
							{exp.title}
						</h3>
						<p class="mt-0.5 text-lg font-medium text-[#1f2a47] dark:text-slate-300">
							{exp.company}
						</p>
						<p class="mt-3 max-w-[40em] text-lg leading-relaxed text-slate-600 dark:text-slate-300">
							{exp.description}
						</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
