---
import {
	Check,
	Copy,
	Linkedin,
	Mail,
	Maximize2,
	Minimize2,
	Phone,
	Send,
} from "lucide-react";

const email = "anthonyrosen@gmail.com";
const phoneDisplay = "612-281-2280";
const phoneHref = "+16122812280";
const contactEndpoint = "/api/contact";
---

<footer id="contact" class="site-footer">
	<div class="site-footer-inner">
		<section class="footer-contact" aria-labelledby="footer-contact-title">
			<div class="footer-contact-copy">
				<p class="footer-eyebrow">Let’s talk</p>
				<h2 id="footer-contact-title">Ready to get to work?</h2>

				<div
					class="footer-contact-options"
					aria-label="Direct contact options"
					data-copy-area
				>
					<div class="footer-copy-group" data-copy-group>
						<div class="footer-copy-row">
							<button
								type="button"
								class="footer-copy-button"
								data-copy-value={email}
								data-copy-kind="email"
								data-copy-location="footer"
								aria-describedby="footer-copy-status"
							>
								<span>{email}</span>
								<span class="footer-copy-icon" aria-hidden="true">
									<Copy size={19} strokeWidth={1.8} data-copy-icon />
									<Check size={19} strokeWidth={2} data-check-icon hidden />
								</span>
								<span class="sr-only">Copy email address</span>
							</button>
							<a
								class="footer-contact-action"
								href={`mailto:${email}`}
								aria-label={`Open a new email to ${email}`}
							>
								<Mail size={20} strokeWidth={1.8} aria-hidden="true" />
							</a>
						</div>
					</div>

					<div class="footer-copy-group" data-copy-group>
						<div class="footer-copy-row">
							<button
								type="button"
								class="footer-copy-button"
								data-copy-value={phoneDisplay}
								data-copy-kind="phone"
								data-copy-location="footer"
								aria-describedby="footer-copy-status"
							>
								<span>{phoneDisplay}</span>
								<span class="footer-copy-icon" aria-hidden="true">
									<Copy size={19} strokeWidth={1.8} data-copy-icon />
									<Check size={19} strokeWidth={2} data-check-icon hidden />
								</span>
								<span class="sr-only">Copy phone number</span>
							</button>
							<a
								class="footer-contact-action"
								href={`tel:${phoneHref}`}
								aria-label={`Call ${phoneDisplay}`}
							>
								<Phone size={20} strokeWidth={1.8} aria-hidden="true" />
							</a>
						</div>
						<p
							id="footer-copy-status"
							class="footer-copy-status"
							data-copy-status
							data-copy-default="Click the email or phone number to copy it. Use the icons to email or call."
							aria-live="polite"
						>
							Click the email or phone number to copy it. Use the icons to email
							or call.
						</p>
					</div>

					<div class="footer-socials" aria-label="Social links">
						<a
							href="https://linkedin.com/in/anthonyrosen"
							target="_blank"
							rel="noreferrer"
							aria-label="Anthony Rosen on LinkedIn"
						>
							<Linkedin size={20} strokeWidth={1.8} aria-hidden="true" />
						</a>
					</div>
				</div>
			</div>

			<section class="footer-form-panel" aria-label="Contact options">
				<p class="footer-form-kicker">Choose what works for you</p>

				<div class="footer-tabs" data-contact-tabs id="footer-connect-tabs">
					<div
						class="footer-tab-list"
						role="tablist"
						aria-label="Contact options"
					>
						<button
							type="button"
							role="tab"
							id="footer-schedule-tab"
							aria-controls="footer-schedule-panel"
							aria-selected="true"
							data-contact-tab="schedule"
						>
							Schedule a call
						</button>
						<button
							type="button"
							role="tab"
							id="footer-form-tab"
							aria-controls="footer-quick-note-panel"
							aria-selected="false"
							tabindex="-1"
							data-contact-tab="form"
						>
							Send a quick note
						</button>
					</div>

					<div
						id="footer-schedule-panel"
						class="footer-tab-panel"
						role="tabpanel"
						aria-labelledby="footer-schedule-tab"
						data-contact-panel="schedule"
					>
						<div class="footer-cal-inline" data-cal-inline>
							<div class="footer-cal-loading" data-cal-loading role="status">
								<span class="sr-only">Loading available times…</span>
								<div class="footer-cal-loading-toolbar" aria-hidden="true">
									<span></span><strong></strong><span></span>
								</div>
								<div class="footer-cal-loading-grid" aria-hidden="true"></div>
							</div>
							<a
								href="https://app.cal.com/anthonyrosen/15min"
								data-cal-fallback
								hidden
							>
								Open scheduling in Cal.com
							</a>
						</div>
					</div>

					<form
						id="footer-quick-note-panel"
						class="footer-form"
						role="tabpanel"
						aria-labelledby="footer-form-tab"
						action={contactEndpoint}
						method="POST"
						data-contact-form
						data-contact-panel="form"
						data-form-location="footer"
						data-endpoint={contactEndpoint}
						hidden
					>
						<div class="footer-form-fields" data-form-content>
							<div class="footer-form-field">
								<label for="footer-contact-name">Name</label>
								<input
									id="footer-contact-name"
									name="name"
									type="text"
									autocomplete="name"
									maxlength="80"
									required
									placeholder="Your name"
								/>
							</div>

							<div class="footer-form-field">
								<label for="footer-contact-email">Email</label>
								<input
									id="footer-contact-email"
									name="email"
									type="email"
									autocomplete="email"
									inputmode="email"
									maxlength="120"
									required
									placeholder="you@example.com"
								/>
							</div>

							<div class="footer-form-field">
								<div class="footer-message-label-row">
									<label for="footer-contact-message">Message</label>
									<button
										type="button"
										class="footer-expand-button"
										data-expand-message
										aria-controls="footer-contact-message"
										aria-expanded="false"
									>
										<Maximize2
											size={14}
											strokeWidth={1.9}
											data-expand-icon
											aria-hidden="true"
										/>
										<Minimize2
											size={14}
											strokeWidth={1.9}
											data-collapse-icon
											aria-hidden="true"
											hidden
										/>
										<span data-expand-label>Expand writing space</span>
									</button>
								</div>
								<textarea
									id="footer-contact-message"
									name="message"
									rows="5"
									minlength="10"
									maxlength="2000"
									required
									placeholder="A little context, a link, or simply what you’re hoping to do."
									data-expandable-message></textarea>
							</div>

							<div class="footer-form-honeypot" aria-hidden="true">
								<label for="footer-company-website"
									>Leave this field blank</label
								>
								<input
									id="footer-company-website"
									name="_gotcha"
									type="text"
									tabindex="-1"
									autocomplete="off"
								/>
							</div>

							<button type="submit" class="footer-form-submit">
								<Send size={17} strokeWidth={1.8} aria-hidden="true" />
								<span data-submit-label>Send message</span>
							</button>
							<p class="footer-form-privacy">
								I’ll only use these details to reply.
							</p>
							<p class="footer-form-status" data-form-status aria-live="polite">
							</p>
						</div>

						<div
							class="footer-form-success"
							data-form-success
							role="status"
							tabindex="-1"
							hidden
						>
							<span class="footer-form-success-icon" aria-hidden="true">
								<Check size={24} strokeWidth={2.2} />
							</span>
							<h3>Message sent</h3>
							<p>Thanks—your message is on its way to Anthony.</p>
							<button type="button" data-send-another-message>
								Send another message
							</button>
						</div>
					</form>
				</div>
			</section>
		</section>

		<div class="footer-bottom">
			<div class="footer-brand">
				<a
					href="#home"
					data-target="home"
					class="footer-link footer-brand-link"
				>
					<span class="footer-mark" aria-hidden="true">AR</span>
					<span>Anthony Rosen</span>
				</a>
				<p>
					Marketing Project Manager &amp; Creative Ops Specialist based in
					Minneapolis, MN.
				</p>
			</div>

			<nav class="footer-column" aria-label="Footer navigation">
				<p>Explore</p>
				<ul>
					<li><button class="footer-link" data-target="home">Home</button></li>
					<li>
						<button class="footer-link" data-target="portfolio"
							>Portfolio</button
						>
					</li>
					<li>
						<button class="footer-link" data-target="resume">Résumé</button>
					</li>
				</ul>
			</nav>

			<div class="footer-column">
				<p>Site info</p>
				<ul>
					<li>
						<button class="footer-link" data-target="styleguide"
							>Style Guide</button
						>
					</li>
					<li>
						<button class="footer-link" data-target="colophon">Colophon</button>
					</li>
					<li><a href="/privacy">Privacy Policy</a></li>
					<li class="footer-copyright">
						&copy; <span id="year"></span> Anthony Rosen.
					</li>
				</ul>
			</div>
		</div>
	</div>
</footer>

<script>
	function initFooter() {
		const yearSpan = document.getElementById("year");
		if (yearSpan) yearSpan.textContent = new Date().getFullYear().toString();

		const footerLinks = document.querySelectorAll<HTMLElement>(".footer-link");
		footerLinks.forEach((link) => {
			if (link.dataset.footerInitialized === "true") return;
			link.dataset.footerInitialized = "true";

			link.addEventListener("click", (event) => {
				event.preventDefault();
				const target = link.dataset.target;
				if (!target) return;

				const isHomePage =
					window.location.pathname === "/" ||
					window.location.pathname === "/index.html" ||
					window.location.pathname.endsWith("/");

				if (isHomePage) {
					window.dispatchEvent(
						new CustomEvent("view-change", { detail: target })
					);
				} else {
					window.location.href = target === "home" ? "/" : `/#${target}`;
				}
			});
		});

		const expandButton = document.querySelector<HTMLButtonElement>(
			"[data-expand-message]"
		);
		if (expandButton && expandButton.dataset.initialized !== "true") {
			expandButton.dataset.initialized = "true";
			expandButton.addEventListener("click", () => {
				const textarea = document.querySelector<HTMLTextAreaElement>(
					"[data-expandable-message]"
				);
				const label = expandButton.querySelector<HTMLElement>(
					"[data-expand-label]"
				);
				const expandIcon =
					expandButton.querySelector<SVGElement>("[data-expand-icon]");
				const collapseIcon = expandButton.querySelector<SVGElement>(
					"[data-collapse-icon]"
				);
				if (!textarea || !label) return;

				const expanded = expandButton.getAttribute("aria-expanded") === "true";
				expandButton.setAttribute("aria-expanded", String(!expanded));
				textarea.classList.toggle("is-expanded", !expanded);
				label.textContent = expanded
					? "Expand writing space"
					: "Collapse writing space";
				expandIcon?.toggleAttribute("hidden", !expanded);
				collapseIcon?.toggleAttribute("hidden", expanded);
				if (!expanded) textarea.focus();
			});
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initFooter, { once: true });
	} else {
		initFooter();
	}
	document.addEventListener("astro:page-load", initFooter);
</script>

<style>
	.site-footer {
		position: relative;
		z-index: 50;
		padding: clamp(3rem, 7vw, 6rem) 1rem 2.5rem;
		border-top: 1px solid #1e293b;
		background: #0f172a;
		color: white;
	}

	.site-footer-inner {
		width: min(100%, 85rem);
		margin: 0 auto;
	}

	.footer-contact {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: start;
		padding-bottom: clamp(3.5rem, 7vw, 6rem);
	}

	.footer-eyebrow {
		margin: 0 0 0.8rem;
		color: #93c5fd;
		font:
			750 0.72rem/1.2 Inter,
			system-ui,
			sans-serif;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.footer-contact-copy h2 {
		max-width: 10ch;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.8rem, 6vw, 5.6rem);
		font-weight: 500;
		line-height: 0.95;
		letter-spacing: -0.055em;
	}

	.footer-contact-copy > p:not(.footer-eyebrow) {
		max-width: 37ch;
		margin: 1.25rem 0 0;
		color: #cbd5e1;
		font:
			0.95rem/1.65 Inter,
			system-ui,
			sans-serif;
	}

	.footer-contact-options {
		margin-top: 2rem;
		padding: clamp(1.25rem, 3vw, 2rem);
		border: 1px solid rgba(255, 255, 255, 0.13);
		border-radius: 1.35rem;
		background: rgba(255, 255, 255, 0.045);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
	}

	.footer-copy-row {
		display: flex;
		gap: 0.55rem;
	}

	.footer-copy-group + .footer-copy-group {
		margin-top: 1rem;
	}

	.footer-copy-button,
	.footer-contact-action,
	.footer-socials a {
		border: 1px solid rgba(255, 255, 255, 0.16);
		background: rgba(255, 255, 255, 0.055);
		color: white;
		font-family: Inter, system-ui, sans-serif;
		text-decoration: none;
		transition:
			background 150ms ease,
			border-color 150ms ease;
	}

	.footer-copy-button {
		display: flex;
		min-width: 0;
		min-height: 3.5rem;
		flex: 1;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0 1rem;
		border-radius: 0.85rem;
		cursor: pointer;
		font-size: clamp(0.8rem, 2vw, 0.96rem);
		text-align: left;
	}

	.footer-copy-button > span:first-child {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.footer-copy-icon,
	.footer-contact-action {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
	}

	.footer-contact-action {
		width: 3.5rem;
		border-radius: 0.85rem;
	}

	.footer-copy-button:hover,
	.footer-contact-action:hover,
	.footer-socials a:hover {
		border-color: rgba(147, 197, 253, 0.62);
		background: rgba(147, 197, 253, 0.12);
	}

	.footer-copy-status {
		min-height: 1.25rem;
		margin: 0.5rem 0 1rem;
		color: #94a3b8;
		font:
			0.7rem/1.4 Inter,
			system-ui,
			sans-serif;
	}

	.footer-socials {
		display: flex;
		gap: 0.55rem;
		margin-top: 0.85rem;
		padding-top: 0.85rem;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.footer-socials a {
		display: inline-flex;
		width: 2.75rem;
		height: 2.75rem;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
	}

	.footer-form-panel {
		padding: clamp(1.4rem, 3.4vw, 2.35rem);
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 1.4rem;
		background: #fbf7ef;
		box-shadow: 0 24px 70px rgba(2, 8, 23, 0.22);
		color: #10233e;
	}

	.footer-form-kicker {
		margin: 0 0 0.55rem;
		color: #315b89;
		font:
			750 0.7rem/1.2 Inter,
			system-ui,
			sans-serif;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.footer-tabs {
		margin-top: 1.35rem;
	}

	.footer-tab-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.3rem;
		padding: 0.3rem;
		border: 1px solid #cbd5e1;
		border-radius: 0.9rem;
		background: rgba(255, 255, 255, 0.68);
	}

	.footer-tab-list button {
		min-height: 2.65rem;
		padding: 0.55rem 0.7rem;
		border: 0;
		border-radius: 0.65rem;
		background: transparent;
		color: #475569;
		cursor: pointer;
		font:
			750 0.76rem/1.2 Inter,
			system-ui,
			sans-serif;
	}

	.footer-tab-list button[aria-selected="true"] {
		background: #10233e;
		box-shadow: 0 4px 14px rgba(16, 35, 62, 0.18);
		color: white;
	}

	.footer-tab-panel,
	.footer-form {
		margin-top: 1rem;
	}

	.footer-cal-inline {
		position: relative;
		min-height: 32rem;
		border: 1px solid #d7dee7;
		border-radius: 0.9rem;
		background: white;
		overflow: hidden;
	}

	.footer-cal-inline > a {
		display: block;
		margin: 0;
		padding: 1.25rem;
		color: #475569;
		font:
			0.82rem/1.5 Inter,
			system-ui,
			sans-serif;
		text-align: center;
	}

	.footer-cal-inline > a {
		color: #1d4ed8;
		font-weight: 700;
	}

	.footer-cal-loading {
		position: absolute;
		inset: 0;
		z-index: 1;
		padding: 1.35rem;
		background: white;
		opacity: 1;
		pointer-events: none;
		transition: opacity 160ms ease;
	}

	.footer-cal-inline.is-ready .footer-cal-loading {
		opacity: 0;
	}

	.footer-cal-loading-toolbar {
		display: grid;
		grid-template-columns: 2.25rem 1fr 2.25rem;
		gap: 1rem;
		align-items: center;
		margin-bottom: 1.4rem;
	}

	.footer-cal-loading-toolbar span,
	.footer-cal-loading-toolbar strong,
	.footer-cal-loading-grid {
		background: linear-gradient(90deg, #eef2f6 25%, #f8fafc 50%, #eef2f6 75%);
		background-size: 200% 100%;
		animation: footer-cal-shimmer 1.25s ease-in-out infinite;
	}

	.footer-cal-loading-toolbar span {
		height: 2.25rem;
		border-radius: 999px;
	}

	.footer-cal-loading-toolbar strong {
		justify-self: center;
		width: 8rem;
		height: 1.1rem;
		border-radius: 999px;
	}

	.footer-cal-loading-grid {
		height: 25rem;
		border-radius: 0.75rem;
		background-image:
			linear-gradient(90deg, transparent 0 13.7%, #fff 13.7% 14.3%),
			linear-gradient(transparent 0 16%, #fff 16% 17%),
			linear-gradient(90deg, #eef2f6 25%, #f8fafc 50%, #eef2f6 75%);
		background-size:
			14.285% 100%,
			100% 16.666%,
			200% 100%;
	}

	@keyframes footer-cal-shimmer {
		to {
			background-position: -200% 0;
		}
	}

	.footer-tabs [hidden] {
		display: none;
	}

	.footer-form {
		margin-top: 1rem;
	}

	.footer-form-fields {
		display: grid;
		gap: 1rem;
	}

	.footer-form-field {
		display: grid;
		gap: 0.42rem;
	}

	.footer-form-field label {
		font:
			700 0.78rem/1.2 Inter,
			system-ui,
			sans-serif;
	}

	.footer-message-label-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.footer-expand-button {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.2rem;
		border: 0;
		background: none;
		color: #315b89;
		cursor: pointer;
		font:
			700 0.7rem/1.2 Inter,
			system-ui,
			sans-serif;
	}

	.footer-expand-button:hover {
		color: #10233e;
	}

	.footer-form-field input,
	.footer-form-field textarea {
		width: 100%;
		border: 1px solid #cbd5e1;
		border-radius: 0.75rem;
		background: rgba(255, 255, 255, 0.84);
		color: #10233e;
		font:
			0.92rem/1.45 Inter,
			system-ui,
			sans-serif;
		outline: none;
		transition:
			min-height 180ms ease,
			border-color 150ms ease,
			box-shadow 150ms ease,
			background 150ms ease;
	}

	.footer-form-field input {
		height: 2.85rem;
		padding: 0 0.85rem;
	}

	.footer-form-field textarea {
		min-height: 7rem;
		padding: 0.75rem 0.85rem;
		resize: vertical;
	}

	.footer-form-field textarea.is-expanded {
		min-height: 15rem;
	}

	.footer-form-field input::placeholder,
	.footer-form-field textarea::placeholder {
		color: #64748b;
	}

	.footer-form-field input:focus,
	.footer-form-field textarea:focus {
		border-color: #315b89;
		background: white;
		box-shadow: 0 0 0 3px rgba(49, 91, 137, 0.16);
	}

	.footer-form-field input:user-invalid,
	.footer-form-field textarea:user-invalid {
		border-color: #b42318;
	}

	.footer-form-honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
