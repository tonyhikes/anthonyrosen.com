---
// Archived homepage version: "Stone Slam" — the "Tired of the fluff?" hero
// with the fixed 3D cotton-ball scene and the slam entrance animation.
// Reconstructed from the live state at commit c2edaf5^. Noindexed preview,
// linked only from /versions. Not the live site.
import Layout from "../../layouts/Layout.astro";
import ThreeScene from "../../components/versions/stone-slam/ThreeScene.astro";
import Hero from "../../components/versions/stone-slam/Hero.astro";
import SlamSection from "../../components/versions/stone-slam/SlamSection.astro";
import ImpactCharts from "../../components/ImpactCharts.astro";
import Experience from "../../components/Experience.astro";
import VersionSwitcher from "../../components/versions/VersionSwitcher.astro";
---

<Layout
	title="Stone Slam (archived version) | Anthony Rosen"
	noindex={true}
	hideNav={true}
>
	<VersionSwitcher current="stone-slam" />

	<ThreeScene />
	<div id="home-view" class="block">
		<Hero />
		<main
			class="content-layer relative z-10 bg-white shadow-2xl dark:bg-slate-900"
		>
			<SlamSection />
			<ImpactCharts />
			<Experience />
		</main>
	</div>
</Layout>

<style>
	.content-layer {
		position: relative;
		z-index: 10;
		margin-top: 100vh; /* Push content down to reveal the fixed hero */
	}
</style>

<!-- Slam animation styles that this archived version relied on (they no
     longer live in the site's global stylesheet). -->
<style is:global>
	.slam-text {
		text-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
	}

	@keyframes slam {
		0% {
			transform: scale(8);
			opacity: 0;
		}
		40% {
			opacity: 1;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}
</style>

<!-- Lenis styles this version relied on (formerly in the global stylesheet). -->
<style is:global>
	html.lenis,
	html.lenis body {
		height: auto;
	}

	.lenis.lenis-smooth {
		scroll-behavior: auto !important;
	}

	.lenis.lenis-smooth [data-lenis-prevent] {
		overscroll-behavior: contain;
	}

	.lenis.lenis-stopped {
		overflow: hidden;
	}
</style>

<script>
	// Lenis smooth scrolling. The live site no longer loads it, but this
	// version's slam depends on it: SlamSection locks scrolling through
	// window.lenis while the slam plays. It starts immediately (the live
	// version deferred it for Lighthouse) so the lock is ready before the
	// first scroll.
	import Lenis from "lenis";

	const lenis = new Lenis();
	window.lenis = lenis;

	let rafId: number | null = null;
	const raf = (time: number) => {
		lenis.raf(time);
		rafId = requestAnimationFrame(raf);
	};
	const startLoop = () => {
		if (rafId === null) rafId = requestAnimationFrame(raf);
	};
	startLoop();

	// Pause while the tab is hidden to save CPU
	document.addEventListener("visibilitychange", () => {
		if (document.hidden) {
			if (rafId !== null) cancelAnimationFrame(rafId);
			rafId = null;
		} else {
			startLoop();
		}
	});
</script>

<script>
	// This archived page has no SPA view-switching; forward the shared Navbar's
	// view-change events to the live site instead.
	window.addEventListener("view-change", (e: Event) => {
		const viewId = (e as CustomEvent).detail;
		if (viewId === "contact") return; // ContactDialog handles its own event
		window.location.href = viewId === "home" ? "/" : `/#${viewId}`;
	});
</script>
