---
import Layout from "../layouts/Layout.astro";

const samples = [
	{
		category: "Newsletter",
		title: "Alz Amateurs newsletter",
		platform: "Substack",
		href: "https://newsletter.alzamateurs.com/p/the-brains-cleanup-crew-is-becoming",
	},
	{
		category: "Social",
		title: "Social post",
		platform: "Instagram",
		href: "https://www.instagram.com/p/C_vNEXpzWVm/",
	},
	{
		category: "Video",
		title: "Video post",
		platform: "Instagram Reel",
		href: "https://www.instagram.com/reel/DFstRNmvY7p/",
	},
	{
		category: "Blog",
		title:
			"Why your smartphone can’t replace a dedicated satellite communicator for the outdoors",
		platform: "ACR Bivy Stick",
		href: "https://bivystick.com/why-your-smartphone-cant-replace-a-dedicated-satellite-communicator-for-the-outdoors/",
	},
	{
		category: "Influencer",
		title: "Influencer post with @heykiera_",
		platform: "Instagram Reel",
		href: "https://www.instagram.com/heykiera_/reel/DAtzoQos6bq/",
	},
];
---

<Layout
	title="Work Samples | Anthony Rosen"
	description="A selection of Anthony Rosen’s work across newsletters, social media, video, blog posts, and influencer content."
>
	<main class="work-samples" id="main-content">
		<div class="samples-inner">
			<header class="samples-header">
				<p class="samples-eyebrow">Selected work</p>
				<h1>Work samples.</h1>
				<p class="samples-intro">
					A few examples across newsletters, social, video, and more.
				</p>
			</header>
			<ul class="samples-list" aria-label="Work samples">
				{
					samples.map((sample, index) => (
						<li class="sample-row">
							<span class="sample-number" aria-hidden="true">
								{String(index + 1).padStart(2, "0")}
							</span>
							<div class="sample-copy">
								<p class="sample-category">
									{sample.category} · {sample.platform}
								</p>
								<h2>{sample.title}</h2>
								<a
									class="sample-link"
									href={sample.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									{sample.href}
									<span class="sr-only"> (opens in a new tab)</span>
								</a>
							</div>
						</li>
					))
				}
			</ul>
			<p class="samples-note">
				Each sample opens on its original platform in a new tab.
			</p>
		</div>
	</main>
</Layout>

<style>
	.work-samples {
		background: #fff;
		color: #0f172a;
		padding: 8rem 1.25rem 5rem;
	}
	.samples-inner {
		max-width: 56rem;
		margin: 0 auto;
	}
	.samples-header {
		margin-bottom: 2.5rem;
	}
	.samples-eyebrow,
	.sample-category {
		color: #2563eb;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.samples-header h1 {
		margin: 0.75rem 0 1rem;
		font-size: 3rem;
		font-weight: 750;
		letter-spacing: -0.045em;
		line-height: 1.1;
	}
	.samples-intro {
		max-width: 34rem;
		color: #475569;
		font-size: 1.125rem;
		line-height: 1.7;
	}
	.samples-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid #e2e8f0;
	}
	.sample-row {
		display: flex;
		align-items: flex-start;
		gap: 1.5rem;
		padding: 1.5rem 0;
		border-bottom: 1px solid #e2e8f0;
	}
	.sample-number {
		padding-top: 0.1rem;
		color: #64748b;
		font-size: 0.875rem;
	}
	.sample-copy {
		flex: 1;
		min-width: 0;
	}
	.sample-copy h2 {
		margin: 0.4rem 0;
		font-size: 1.125rem;
		font-weight: 650;
		line-height: 1.5;
		overflow-wrap: break-word;
	}
	.sample-link {
		color: #1d4ed8;
		font-size: 0.875rem;
		line-height: 1.8;
		text-decoration: underline;
		text-underline-offset: 3px;
		overflow-wrap: break-word;
		word-break: break-word;
	}
	.sample-link:hover {
		color: #1e40af;
	}
	.sample-link:focus-visible {
		outline: 3px solid #2563eb;
		outline-offset: 4px;
	}
	.samples-note {
		margin-top: 1.5rem;
		color: #64748b;
		font-size: 0.875rem;
		line-height: 1.6;
	}
	:global(.dark) .work-samples {
		background: #0f172a;
		color: #f8fafc;
	}
	:global(.dark) .samples-intro {
		color: #cbd5e1;
	}
	:global(.dark) .samples-list,
	:global(.dark) .sample-row {
		border-color: #334155;
	}
	:global(.dark) .samples-eyebrow,
	:global(.dark) .sample-category,
	:global(.dark) .sample-link {
		color: #93c5fd;
	}
	:global(.dark) .sample-link:hover {
		color: #bfdbfe;
	}
	:global(.dark) .sample-number,
	:global(.dark) .samples-note {
		color: #94a3b8;
	}
	@media (max-width: 480px) {
		.work-samples {
			padding-top: 6.5rem;
			padding-bottom: 3.5rem;
		}
		.samples-header h1 {
			font-size: 2.5rem;
		}
		.sample-row {
			gap: 0.75rem;
			padding: 1.25rem 0;
		}
		.sample-number {
			display: none;
		}
	}
</style>
