---
import Layout from "../layouts/Layout.astro";

const samples: { title: string; href: string; role?: string }[] = [
	{
		title: "Newsletter: Alzheimer's for Amateurs",
		href: "https://newsletter.alzamateurs.com/p/the-brains-cleanup-crew-is-becoming",
	},
	{
		title:
			"Blog post: Why your smartphone can’t replace a dedicated satellite communicator for the outdoors",
		href: "https://bivystick.com/why-your-smartphone-cant-replace-a-dedicated-satellite-communicator-for-the-outdoors/",
	},
	{
		title: "Social post",
		href: "https://www.instagram.com/p/C_vNEXpzWVm/?utm_source=ig_web_copy_link&stkn=NTc4MTIwNjQ2YQ==",
	},
	{
		title: "Influencer post with @heykiera_",
		href: "https://www.instagram.com/reel/DAtzoQos6bq/?utm_source=ig_web_copy_link&stkn=NTc4MTIwNjQ2YQ==",
	},
	{
		title: "Video post",
		href: "https://www.instagram.com/reel/DFstRNmvY7p/?utm_source=ig_web_button_share_sheet&stkn=MzRlODBiNWFlZA==",
	},
	{
		title: "Video: Tutorial video",
		href: "https://www.youtube.com/watch?v=TJ4bDq5koCA",
		role: "Wrote the script, edited, built the animations, and hired the voice artist.",
	},
	{
		title: "Video: On-location shoot",
		href: "https://www.youtube.com/watch?v=soiWN_O5cGE",
		role: "Planned the shoot: scripts, logistics, and location.",
	},
	{
		title: "Video: 3D product visualization",
		href: "https://www.youtube.com/watch?v=ynfIxBByr5o",
		role: "Directed the 3D product visualization and wrote the storyboard.",
	},
	{
		title: "Video: Founder story video campaign",
		href: "https://www.youtube.com/watch?v=t1SF230evEE",
		role: "Planned the shoot and logistics, managed the video editor, and ran the launch and ad campaign.",
	},
	{
		title: "Video: On-location shoot",
		href: "https://www.youtube.com/watch?v=s-rOd9A_b70",
		role: "Planned the shoot: scripts, logistics, and location.",
	},
	{
		title: "Video: Low-budget product explainer",
		href: "https://www.youtube.com/watch?v=SFT6xyyUnPo",
		role: "New product explainer on a very low budget. Wrote the script, produced the main and feature animations, edited, and cast the voice actor.",
	},
	{
		title: "Website: Bivy marketing site",
		href: "https://bivystick.com/case-study/motocross-legend-ricky-carmichael-relies-on-acr-bivy-stick-for-seamless-communication-and-tracking-during-epic-summer-adventure-ride/",
		role: "Built the customer-focused marketing site from scratch: case studies, product pages, blog, and landing pages.",
	},
];
---

<Layout
	title="Work Samples | Anthony Rosen"
	description="A selection of Anthony Rosen’s work across newsletters, social media, video, blog posts, and influencer content."
>
	<main class="work-samples" id="main-content">
		<div class="samples-inner">
			<header class="samples-header">
				<h1>Writing, social, video &amp; web samples</h1>
			</header>
			<ul class="samples-list" aria-label="Work samples">
				{
					samples.map((sample) => (
						<li class="sample-row">
							<a
								class="sample-link"
								href={sample.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								<h2>{sample.title}</h2>
								{sample.role && <p class="sample-role">{sample.role}</p>}
								<span class="sample-url">{sample.href}</span>
								<span class="sr-only"> (opens in a new tab)</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</main>
</Layout>

<style>
	.work-samples {
		background: #fff;
		color: #0f172a;
		padding: 7rem 2rem 4rem;
	}
	.samples-inner {
		max-width: 56rem;
		margin: 0;
		text-align: left;
	}
	.samples-header {
		margin-bottom: 1.5rem;
	}
	.samples-header h1 {
		margin: 0;
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: -0.025em;
		line-height: 1.4;
	}
	.samples-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid #e2e8f0;
	}
	.sample-row {
		border-bottom: 1px solid #e2e8f0;
	}
	.sample-link {
		display: block;
		padding: 1.25rem 0;
		color: inherit;
		text-decoration: none;
		overflow-wrap: break-word;
		word-break: break-word;
	}
	.sample-link h2 {
		margin: 0 0 0.4rem;
		font-size: 1.125rem;
		font-weight: 650;
		line-height: 1.5;
	}
	.sample-role {
		margin: 0 0 0.4rem;
		color: #475569;
		font-size: 0.9375rem;
		line-height: 1.6;
	}
	:global(.dark) .sample-role {
		color: #94a3b8;
	}
	.sample-url {
		color: #1d4ed8;
		font-size: 0.875rem;
		line-height: 1.8;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.sample-link:hover h2,
	.sample-link:hover .sample-url {
		color: #1e40af;
	}
	.sample-link:focus-visible {
		outline: 3px solid #2563eb;
		outline-offset: 4px;
	}
	:global(.dark) .work-samples {
		background: #0f172a;
		color: #f8fafc;
	}
	:global(.dark) .samples-list,
	:global(.dark) .sample-row {
		border-color: #334155;
	}
	:global(.dark) .sample-url {
		color: #93c5fd;
	}
	:global(.dark) .sample-link:hover h2,
	:global(.dark) .sample-link:hover .sample-url {
		color: #bfdbfe;
	}
	@media (max-width: 1023px) {
		.work-samples {
			padding-left: 1.5rem;
			padding-right: 1.5rem;
		}
	}
	@media (max-width: 639px) {
		.work-samples {
			padding: 6rem 1rem 3rem;
		}
		.samples-header h1 {
			font-size: 1.5rem;
		}
	}
</style>
