<script>
	// The shared Navbar dispatches view-change events that only the main SPA
	// page handles. On this standalone draft, forward them to the real page.
	window.addEventListener("view-change", (e: Event) => {
		const viewId = (e as CustomEvent).detail;
		window.location.href = viewId === "home" ? "/" : `/#${viewId}`;
	});
</script>
