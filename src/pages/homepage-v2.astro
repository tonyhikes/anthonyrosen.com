---
// Homepage v2.0 — DRAFT
// Recruiter-first redesign: leads with who Tony is, what he delivers, and
// proof (metrics, brands, outcomes) above the fold instead of the teaser hero.
// Not linked from navigation, noindexed, and excluded from the sitemap.
import Layout from "../layouts/Layout.astro";
---

<Layout title="Tony Rosen | Marketing & Creative Project Manager" noindex={true}>
	<!-- Draft banner -->
	<div
		class="fixed top-0 right-0 left-0 z-[60] bg-amber-400 px-4 py-1.5 text-center text-xs font-bold tracking-widest text-amber-950 uppercase"
	>
		Draft — Homepage v2.0 · Not published
	</div>

	<main class="relative z-10 bg-white pt-8 dark:bg-slate-900">
		<!-- ============ HERO ============ -->
		<section
			class="relative overflow-hidden border-b border-slate-100 dark:border-slate-800"
		>
			<!-- Subtle background accent -->
			<div
				class="pointer-events-none absolute inset-0 bg-gradient-to-b from-blue-50/80 via-transparent to-transparent dark:from-blue-950/30"
			>
			</div>

			<div class="relative mx-auto max-w-6xl px-4 pt-32 pb-16 md:pt-40 md:pb-24">
				<!-- Availability badge -->
				<div
					class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-4 py-1.5 text-sm font-medium text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-400"
				>
					<span class="relative flex h-2 w-2">
						<span
							class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
						></span>
						<span
							class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"
						></span>
					</span>
