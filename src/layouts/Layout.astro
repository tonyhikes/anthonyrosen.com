---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import "../styles/global.css";
import PostHog from "../components/PostHog.astro";
import SEO from "../components/SEO.astro";
import LinkedInTag from "../components/LinkedInTag.astro";
import RB2B from "../components/RB2B.astro";
import JobSearchAnalytics from "../components/JobSearchAnalytics.astro";
import ContactDialog from "../components/ContactDialog.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<SEO
			title={title}
			description="Anthony Rosen - Marketing & Creative Project Manager. Specialized in product marketing, satellite communications, and creative team leadership."
		/>
		<link
			rel="icon"
			type="image/png"
			href="/favicon-dark.png"
			media="(prefers-color-scheme: dark)"
		/>
		<link
			rel="icon"
			type="image/png"
			href="/favicon-light.png"
			media="(prefers-color-scheme: light)"
		/>
		<meta name="generator" content={Astro.generator} />

		<!-- DNS prefetch for analytics (loaded later via requestIdleCallback) -->
		<link rel="dns-prefetch" href="https://us.i.posthog.com" />
		<link rel="dns-prefetch" href="https://us-assets.i.posthog.com" />
		<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
		<link rel="dns-prefetch" href="https://snap.licdn.com" />
		<!-- Warm the calendar connection without downloading the embed on page load. -->
		<link rel="preconnect" href="https://app.cal.com" crossorigin />
		<link
			rel="dns-prefetch"
			href="https://b2bjsstore.s3.us-west-2.amazonaws.com"
		/>

		<!-- Inline critical CSS for initial render to improve FCP -->
		<style is:inline>
			/* Critical above-the-fold styles */
			html {
				height: auto;
			}
			body {
				margin: 0;
				background-color: rgb(15 23 42); /* slate-900 */
				color: white;
				font-family:
					Inter,
					system-ui,
					-apple-system,
					sans-serif;
				transition:
					color 0.3s,
					background-color 0.3s;
			}
			/* Prevent layout shift */
			* {
				box-sizing: border-box;
			}
			/* Keep Tailwind visibility classes working before the main stylesheet
			   loads. These live in a cascade layer on purpose: unlayered rules
			   outrank every layered one regardless of specificity or order, and
			   Tailwind ships its utilities in @layer utilities. Unlayered, the
			   .hidden below would beat `sm:block`, `lg:flex` and every other
			   responsive display variant site-wide. Because this layer is
			   declared before Tailwind's, its rules lose to them once the main
			   stylesheet arrives, while still applying before it does. */
			@layer critical-fallback {
				.hidden {
					display: none;
				}
				.block {
					display: block;
				}
			}
			html[data-initial-view="resume"] #home-view,
			html[data-initial-view="portfolio"] #home-view,
			html[data-initial-view="styleguide"] #home-view,
			html[data-initial-view="colophon"] #home-view {
				display: none !important;
			}
			html[data-initial-view="resume"] #resume-view,
			html[data-initial-view="portfolio"] #portfolio-view,
			html[data-initial-view="styleguide"] #styleguide-view,
			html[data-initial-view="colophon"] #colophon-view {
				display: block !important;
			}
		</style>

		<script is:inline>
			// Initialize Theme
			if (
				localStorage.getItem("theme") === "dark" ||
				(!("theme" in localStorage) &&
					window.matchMedia("(prefers-color-scheme: dark)").matches)
			) {
				document.documentElement.classList.add("dark");
			} else {
				document.documentElement.classList.remove("dark");
			}
		</script>
		<script is:inline>
			const initialHashView = window.location.hash.replace("#", "");
			if (
				["resume", "portfolio", "styleguide", "colophon"].includes(
					initialHashView
				)
			) {
				document.documentElement.dataset.initialView = initialHashView;
			}
		</script>
		<script is:inline>
			const ANALYTICS_READY_EVENT = "anthony-analytics-ready";
			const analyticsInteractionEvents = [
				"pointerdown",
				"keydown",
				"touchstart",
				"wheel",
			];

			if (!window.__armAnthonyAnalyticsReady) {
				let analyticsFallbackTimer;

				const markAnalyticsReady = () => {
					if (window.__anthonyAnalyticsReady) return;
					window.__anthonyAnalyticsReady = true;
					window.__anthonyAnalyticsReadyArmed = false;

					analyticsInteractionEvents.forEach((eventName) => {
						window.removeEventListener(eventName, markAnalyticsReady);
					});

					if (analyticsFallbackTimer) {
						clearTimeout(analyticsFallbackTimer);
					}

					window.dispatchEvent(new CustomEvent(ANALYTICS_READY_EVENT));
				};

				window.__armAnthonyAnalyticsReady = () => {
					if (window.__anthonyAnalyticsReady) {
						window.dispatchEvent(new CustomEvent(ANALYTICS_READY_EVENT));
						return;
					}

					if (window.__anthonyAnalyticsReadyArmed) return;
					window.__anthonyAnalyticsReadyArmed = true;

					analyticsInteractionEvents.forEach((eventName) => {
						window.addEventListener(eventName, markAnalyticsReady, {
							passive: true,
							once: true,
						});
					});

					// Quiet sessions still eventually initialize analytics.
					analyticsFallbackTimer = window.setTimeout(markAnalyticsReady, 15000);
				};
			}
		</script>
		<!-- Google tag (gtag.js) - Deferred for performance -->
		<script is:inline>
			const CONSENT_KEY = "cookie-consent";
			const GA_ANALYTICS_READY_EVENT = "anthony-analytics-ready";
			let gaScheduled = false;
			let gaWaitingForReady = false;

			// Defer Google Analytics to improve initial page load
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				window.dataLayer.push(arguments);
			}
			gtag("js", new Date());
			gtag("config", "G-7LRLJTJG4L", { send_page_view: false });

			// Load GA script after page is interactive
			function loadGA() {
				const script = document.createElement("script");
				script.src = "https://www.googletagmanager.com/gtag/js?id=G-7LRLJTJG4L";
				script.async = true;
				document.head.appendChild(script);
			}

			function scheduleGA() {
				if (gaScheduled) return;
				gaScheduled = true;

				// PERFORMANCE OPTIMIZATION: Increased timeout to keep GA off critical path
				// Changed from 5s to 10s to avoid interfering with Lighthouse measurements
				if ("requestIdleCallback" in window) {
					requestIdleCallback(loadGA, { timeout: 10000 });
				} else {
					setTimeout(loadGA, 5000);
				}
			}

			function requestGAStart() {
				if (gaScheduled) return;

				if (window.__anthonyAnalyticsReady) {
					scheduleGA();
					return;
				}

				if (gaWaitingForReady) return;
				gaWaitingForReady = true;

				window.addEventListener(
					GA_ANALYTICS_READY_EVENT,
					() => {
						gaWaitingForReady = false;
						scheduleGA();
					},
					{ once: true }
				);

				window.__armAnthonyAnalyticsReady?.();
			}

			if (localStorage.getItem(CONSENT_KEY) === "accepted") {
				requestGAStart();
			}

			window.addEventListener("cookie-consent-updated", (event) => {
				if (event.detail === "accepted") {
					requestGAStart();
				}
			});
		</script>
		<PostHog />
		<LinkedInTag />
		<RB2B />
		<JobSearchAnalytics />
	</head>
	<body
		class="bg-slate-900 text-gray-900 transition-colors duration-300 selection:bg-blue-500 selection:text-white dark:text-white"
	>
		<Navbar />
		<slot />
		<Footer />
		<ContactDialog />
		<CookieBanner />
	</body>
</html>
